      <span style={{ ...{
        fontFamily: "'Fira Code', monospace", fontSize: 10,
        letterSpacing: '0.28em', textTransform: 'uppercase',
        color: palette.accent
      }, color: "rgb(0, 185, 211)" }}>// Handbuch</span>
      <h1 style={{
      fontFamily: "'Rajdhani', sans-serif", fontWeight: 700,
