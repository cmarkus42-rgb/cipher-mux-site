const DocsV2 = ({ theme = 'light', accent, density = 'luftig', tab = 'start' }) => {
  const palette = cmPalette(theme, accent);
  const sp = cmSpacing(density);
  const [active, setActive] = React.useState(tab);

  const ActivePage = active === 'konzepte' ? DocsKonzeptePage :
  active === 'nutzung' ? DocsNutzungPage :
  DocsStartPage;

  return (
    <div style={{
      width: '100%', minHeight: '100%', background: palette.bg, color: palette.text,
      fontFamily: "'Fira Code', monospace", position: 'relative'
    }}>
      <CMPageHeader palette={palette} active="docs" />
      <DocsPageHeading palette={palette} sp={sp} />
      <TabBar active={active} onChange={setActive} palette={palette} />
      <CMAnchorNav items={ANCHORS[active]} active={0} palette={palette} />
      <ActivePage palette={palette} sp={sp} />
      <DocsBottomV2 palette={palette} sp={sp} />
      <CMPageFooter palette={palette} />
    </div>);

};

