// CIPHER-MUX Docs v2 — Composer mit Tab-Routing.
// Top sticky tab bar + Anchor-Nav rechts (eigen pro Tab).

const TABS = [
{ id: 'start', label: 'Schnelleinstieg', sub: '01 · Vom Start zum Projekt' },
{ id: 'konzepte', label: 'Prozess & Konzepte', sub: '02 · Warum spezialisierte Sessions' },
{ id: 'nutzung', label: 'Nutzung der App', sub: '03 · Volle Referenz' }];


const TabBar = ({ active, onChange, palette }) =>
<div style={{
  position: 'sticky', top: 64, zIndex: 10,
  background: palette.bg, borderBottom: `1px solid ${palette.border}`,
  display: 'flex', alignItems: 'stretch',
  padding: '0 56px'
}}>
    {TABS.map((tab) => {
    const isActive = active === tab.id;
    return (
      <button key={tab.id} onClick={() => onChange(tab.id)} style={{
        all: 'unset', cursor: 'pointer',
        padding: '14px 22px',
        borderBottom: isActive ? `2px solid ${palette.accent}` : '2px solid transparent',
        marginBottom: -1,
        display: 'flex', flexDirection: 'column', gap: 2,
        whiteSpace: 'nowrap'
      }}>
          <span style={{
          fontFamily: "'Rajdhani', sans-serif", fontWeight: 700, fontSize: 16,
          color: isActive ? palette.text : palette.textDim, letterSpacing: -0.1
        }}>{tab.label}</span>
          <span style={{ ...{
            fontFamily: "'Fira Code', monospace", fontSize: 10,
            color: isActive ? palette.accent : palette.textDim, letterSpacing: 1.2
          }, color: "rgb(0, 190, 217)" }}>{tab.sub}</span>
        </button>);

  })}
  </div>;


const ANCHORS = {
  start: [
  { id: 'orientation', label: '01 · Orientierung' },
  { id: 'workspace', label: '02 · Workspace' },
  { id: 'sessions', label: '03 · Sessions' },
