---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/theme-light.css';
import '../styles/theme-dark.css';
import '../styles/components.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  active?: string;
}

const { title, description, lang = 'de', active } = Astro.props;

const ogUrl = `https://cipher-mux.dev${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content="https://cipher-mux.dev/images/social-preview.png" />
    <meta name="theme-color" content="#F4F3ED" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2E3440" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme;
        if (stored === 'dark' || stored === 'light') {
          theme = stored;
        } else {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
    <div class="prerelease-banner" role="status">
      <span class="prerelease-banner__tag">OPEN BETA</span>
      <span class="prerelease-banner__text">{lang === 'de' ? 'Aktiv in Entwicklung — Feedback willkommen.' : 'Actively developed — feedback welcome.'}</span>
    </div>
    <Header lang={lang} active={active} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Lightbox overlay -->
    <div id="lightbox" aria-hidden="true">
      <img id="lightbox-img" alt="" />
    </div>
    <style>
      #lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s, visibility 0.2s;
      }
      #lightbox[aria-hidden="false"] {
        opacity: 1;
        visibility: visible;
      }
      #lightbox-img {
        max-width: 92vw;
        max-height: 92vh;
        object-fit: contain;
        border-radius: 4px;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
      }
    </style>
    <script is:inline>
      (function () {
        var lb = document.getElementById('lightbox');
        var lbImg = document.getElementById('lightbox-img');
        document.addEventListener('click', function (e) {
          var img = e.target.closest('[data-lightbox]');
          if (img) {
            var src = img.tagName === 'IMG' ? img.src : img.querySelector('img:not([style*="display: none"]),.screenshot-light:not([style*="display: none"]),.screenshot-dark:not([style*="display: none"])')?.src;
            if (!src) {
              // Find visible img
              var imgs = img.querySelectorAll('img');
              for (var i = 0; i < imgs.length; i++) {
                if (imgs[i].offsetParent !== null) { src = imgs[i].src; break; }
              }
            }
            if (src) {
              lbImg.src = src;
              lbImg.alt = img.alt || img.querySelector('img')?.alt || '';
              lb.setAttribute('aria-hidden', 'false');
              document.body.style.overflow = 'hidden';
            }
          }
        });
        lb.addEventListener('click', function () {
          lb.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && lb.getAttribute('aria-hidden') === 'false') {
            lb.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        });
      })();
    </script>
  </body>
</html>
