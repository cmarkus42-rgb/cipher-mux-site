---
// ThemeShowcase.astro — Easter-egg: live theme preview for the 10 CIPHER-MUX themes
---

<section class="theme-showcase" aria-label="Theme-Vorschau">
  <div class="showcase-inner">
    <div class="showcase-header">
      <span class="label-tag">Easter Egg</span>
      <h3 class="showcase-title">So fuehlt sich CIPHER-MUX an.</h3>
      <p class="showcase-sub">Klick auf ein Theme — die Seite wechselt live.</p>
    </div>

    <div class="theme-grid" id="theme-grid">
      <!-- Tiles rendered by JS to keep data co-located with behavior -->
    </div>

    <div class="showcase-actions">
      <button class="btn" id="theme-reset">Zuruecksetzen</button>
    </div>
  </div>
</section>

<style>
  .theme-showcase {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-sunken);
  }

  .showcase-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4xl) var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .showcase-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .showcase-title {
    font-family: 'Rajdhani', Impact, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--color-text);
    margin-top: var(--space-sm);
  }

  .showcase-sub {
    font-size: 13px;
    color: var(--color-text-dim);
    font-family: 'Fira Code', monospace;
  }

  /* Grid: responsive auto-fill, each tile at least 120px */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--space-md);
  }

  /* Tile base — styled via JS inline style for bg/accent */
  :global(.theme-tile) {
    position: relative;
    height: 80px;
    cursor: pointer;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1.5px solid transparent;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    transition: transform 0.12s ease, border-color 0.12s ease;
    user-select: none;
  }

  :global(.theme-tile:hover) {
    transform: scale(1.04);
  }

  :global(.theme-tile.is-active) {
    border-width: 2px;
  }

  :global(.theme-tile__name) {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
    line-height: 1.3;
    word-break: break-word;
    /* color is set inline via JS */
  }

  :global(.theme-tile__swatch) {
    width: 100%;
    height: 6px;
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
    /* background is set inline via JS */
  }

  .showcase-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  @media (max-width: 480px) {
    .theme-grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }
    .showcase-inner {
      padding: var(--space-3xl) var(--space-lg);
    }
  }
</style>

<script>
  const THEMES = [
    {
      id: 'cipher-ivory',
      name: 'cipher-ivory',
      bg: '#F2F2E8',
      bgElevated: '#F8F8F0',
      bgSunken: '#E8E8DC',
      text: '#1A1A1D',
      textSecondary: '#4A4A50',
      textDim: '#8A8A88',
      accent: '#2d8a4e',
      border: '#3A3F47',
      borderStrong: '#3A3F47',
    },
    {
      id: 'cipher-dark',
      name: 'cipher-dark',
      bg: '#2A2A32',
      bgElevated: '#34343E',
      bgSunken: '#222228',
      text: '#D8D8E0',
      textSecondary: '#ABABB8',
      textDim: '#6A6A78',
      accent: '#5C9A6E',
      border: '#3E3E4A',
      borderStrong: '#5C5C6E',
    },
    {
      id: 'blueprint',
      name: 'blueprint',
      bg: '#0d1b2a',
      bgElevated: '#152536',
      bgSunken: '#081320',
      text: '#a8c4d4',
      textSecondary: '#7AAABE',
      textDim: '#4A7A9A',
      accent: '#4da6c9',
      border: '#1b3a4b',
      borderStrong: '#2a5a72',
    },
    {
      id: 'warm-paper',
      name: 'warm-paper',
      bg: '#f5f0e8',
      bgElevated: '#faf7f2',
      bgSunken: '#ece6d8',
      text: '#3a3530',
      textSecondary: '#6A6055',
      textDim: '#9A9088',
      accent: '#8b6b4a',
      border: '#d4c9b8',
      borderStrong: '#8b6b4a',
    },
    {
      id: 'gruvbox-dark',
      name: 'gruvbox-dark',
      bg: '#282828',
      bgElevated: '#32302f',
      bgSunken: '#1d2021',
      text: '#ebdbb2',
      textSecondary: '#D5C4A1',
      textDim: '#928374',
      accent: '#b8bb26',
      border: '#504945',
      borderStrong: '#7c6f64',
    },
    {
      id: 'nord',
      name: 'nord',
      bg: '#2E3440',
      bgElevated: '#3B4252',
      bgSunken: '#232730',
      text: '#ECEFF4',
      textSecondary: '#D8DEE9',
      textDim: '#7B8394',
      accent: '#88C0D0',
      border: '#434C5E',
      borderStrong: '#4C566A',
    },
    {
      id: 'synthwave',
      name: 'synthwave',
      bg: '#1a1a2e',
      bgElevated: '#242442',
      bgSunken: '#111122',
      text: '#e0e0ff',
      textSecondary: '#B0B0E0',
      textDim: '#6060A0',
      accent: '#ff6ec7',
      border: '#2a2a4e',
      borderStrong: '#4a4a7e',
    },
    {
      id: 'matrix',
      name: 'matrix',
      bg: '#0d0d0d',
      bgElevated: '#181818',
      bgSunken: '#050505',
      text: '#00ff41',
      textSecondary: '#00CC33',
      textDim: '#006618',
      accent: '#00ff41',
      border: '#003b00',
      borderStrong: '#00ff41',
    },
    {
      id: 'brutalist',
      name: 'brutalist',
      bg: '#ffffff',
      bgElevated: '#f4f4f4',
      bgSunken: '#e8e8e8',
      text: '#000000',
      textSecondary: '#333333',
      textDim: '#666666',
      accent: '#000000',
      border: '#000000',
      borderStrong: '#000000',
    },
    {
      id: 'high-contrast',
      name: 'high-contrast',
      bg: '#000000',
      bgElevated: '#111111',
      bgSunken: '#0a0a0a',
      text: '#ffffff',
      textSecondary: '#DDDDDD',
      textDim: '#AAAAAA',
      accent: '#ffff00',
      border: '#ffffff',
      borderStrong: '#ffffff',
    },
  ] as const;

  type Theme = typeof THEMES[number];

  let activeThemeId: string | null = null;

  function applyTheme(theme: Theme) {
    const html = document.documentElement;
    html.style.setProperty('--color-bg', theme.bg);
    html.style.setProperty('--color-bg-elevated', theme.bgElevated);
    html.style.setProperty('--color-bg-sunken', theme.bgSunken);
    html.style.setProperty('--color-text', theme.text);
    html.style.setProperty('--color-text-secondary', theme.textSecondary);
    html.style.setProperty('--color-text-dim', theme.textDim);
    html.style.setProperty('--color-accent', theme.accent);
    html.style.setProperty('--color-accent-hover', theme.accent);
    html.style.setProperty('--color-border', theme.border);
    html.style.setProperty('--color-border-strong', theme.borderStrong);
    activeThemeId = theme.id;
    updateActiveTile();
  }

  function resetTheme() {
    const html = document.documentElement;
    // Remove all inline overrides
    const props = [
      '--color-bg', '--color-bg-elevated', '--color-bg-sunken',
      '--color-text', '--color-text-secondary', '--color-text-dim',
      '--color-accent', '--color-accent-hover',
      '--color-border', '--color-border-strong',
    ];
    props.forEach(p => html.style.removeProperty(p));
    activeThemeId = null;
    updateActiveTile();
  }

  function updateActiveTile() {
    document.querySelectorAll('.theme-tile').forEach(el => {
      const tile = el as HTMLElement;
      const id = tile.dataset.themeId;
      if (id === activeThemeId) {
        tile.classList.add('is-active');
        // Use that theme's accent for the border
        const theme = THEMES.find(t => t.id === id);
        if (theme) tile.style.borderColor = theme.accent;
      } else {
        tile.classList.remove('is-active');
        tile.style.borderColor = 'transparent';
      }
    });
  }

  function buildGrid() {
    const grid = document.getElementById('theme-grid');
    if (!grid) return;

    THEMES.forEach(theme => {
      const tile = document.createElement('div');
      tile.className = 'theme-tile';
      tile.dataset.themeId = theme.id;
      tile.setAttribute('role', 'button');
      tile.setAttribute('tabindex', '0');
      tile.setAttribute('aria-label', `Theme ${theme.name} aktivieren`);
      tile.style.background = theme.bg;
      tile.style.borderColor = 'transparent';

      const name = document.createElement('span');
      name.className = 'theme-tile__name';
      name.textContent = theme.name;
      name.style.color = theme.textDim;

      const swatch = document.createElement('div');
      swatch.className = 'theme-tile__swatch';
      swatch.style.background = theme.accent;

      tile.appendChild(name);
      tile.appendChild(swatch);

      tile.addEventListener('click', () => applyTheme(theme));
      tile.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          applyTheme(theme);
        }
      });

      grid.appendChild(tile);
    });
  }

  function initShowcase() {
    buildGrid();
    const resetBtn = document.getElementById('theme-reset');
    if (resetBtn) resetBtn.addEventListener('click', resetTheme);
  }

  initShowcase();
  document.addEventListener('astro:page-load', initShowcase);
</script>
