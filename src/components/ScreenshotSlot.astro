---
interface Props {
  caption: string;
  placeholder: string;
  src?: string;
}
const { caption, placeholder, src } = Astro.props;
---
<figure class="screenshot-slot">
  {src ? (
    <img
      class="screenshot-slot__img screenshot-light"
      src={`${src}-light.png`}
      alt={caption}
      loading="lazy"
    />
    <img
      class="screenshot-slot__img screenshot-dark"
      src={`${src}-dark.png`}
      alt={caption}
      loading="lazy"
    />
  ) : (
    <div class="screenshot-slot__box">
      <div class="screenshot-slot__caption">{caption}</div>
      <div class="screenshot-slot__placeholder">{placeholder}</div>
    </div>
  )}
  <figcaption class="screenshot-slot__figcaption">{caption}</figcaption>
</figure>

<style>
  .screenshot-slot { margin: 20px 0 14px; }
  .screenshot-slot__img {
    max-width: 100%;
    height: auto;
    border: none;
  }
  .screenshot-slot__figcaption {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 0.5px;
    margin-top: 8px;
    text-align: center;
  }
  .screenshot-slot__box {
    padding: 40px 28px;
    border: 1px dashed var(--color-border);
    background: var(--color-bg-sunken);
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    text-align: center;
    letter-spacing: 0.5px;
  }
  .screenshot-slot__caption {
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
  }
  .screenshot-slot__placeholder {
    font-style: italic;
    opacity: 0.7;
  }
</style>
