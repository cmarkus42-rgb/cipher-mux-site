---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const l = lang as Lang;

const privacyHref = lang === 'de' ? `/${lang}/datenschutz` : `/${lang}/privacy`;
const imprintHref = lang === 'de' ? `/${lang}/impressum` : `/${lang}/imprint`;
---

<footer class="cm-footer">
  <div class="cm-footer-left">
    <span class="cm-dot" style="background: var(--color-accent)"></span>
    <span class="cm-footer-mark">CIPHER-MUX</span>
    <span>{t(l, 'footer.version')}</span>
    <span style="color: var(--color-text-dim)">&middot;</span>
    <a href="https://cipher-mux.dev" style="color: var(--color-accent)">cipher-mux.dev</a>
  </div>
  <div class="cm-footer-right">
    <a href="https://github.com/cmarkus42-rgb/cipher-mux-electron" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://github.com/cmarkus42-rgb/cipher-mux-electron/issues" target="_blank" rel="noopener noreferrer">Issues</a>
    <a href={privacyHref}>{t(l, 'footer.privacy')}</a>
    <a href={imprintHref}>{t(l, 'footer.imprint')}</a>
  </div>
</footer>

<style>
  .cm-footer-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cm-footer-right {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
</style>
