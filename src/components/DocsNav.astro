---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: string;
  activePage?: 'start' | 'concepts' | 'usage' | null;
}

const { lang, activePage = null } = Astro.props;
const l = lang as Lang;

const items = [
  { key: 'start',    label: t(l, 'docs.nav.start'),    sub: t(l, 'docs-nav.start.sub'),    href: `/${lang}/docs/start` },
  { key: 'concepts', label: t(l, 'docs.nav.concepts'), sub: t(l, 'docs-nav.concepts.sub'), href: `/${lang}/docs/concepts` },
  { key: 'usage',    label: t(l, 'docs.nav.usage'),    sub: t(l, 'docs-nav.usage.sub'),    href: `/${lang}/docs/usage` },
];
---

<nav class="docs-nav" aria-label={t(l, 'docs.nav.label')}>
  <div class="docs-nav-tabs">
    {items.map(item => {
      const active = activePage === item.key;
      return (
        <a
          href={item.href}
          class:list={['docs-nav-tab', { 'docs-nav-tab--active': active }]}
        >
          <span class="docs-nav-tab-label">{item.label}</span>
          <span class="docs-nav-tab-sub">{item.sub}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .docs-nav {
    position: sticky;
    top: 52px;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 0 var(--section-pad-x);
  }

  .docs-nav-tabs {
    display: flex;
    gap: 0;
  }

  .docs-nav-tab {
    display: flex;
    flex-direction: column;
    padding: 14px 22px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }

  .docs-nav-tab:hover {
    text-decoration: none;
  }

  .docs-nav-tab-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text-dim);
    transition: color 0.15s;
  }

  .docs-nav-tab-sub {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 1.2px;
    color: var(--color-text-dim);
    transition: color 0.15s;
  }

  .docs-nav-tab:hover .docs-nav-tab-label {
    color: var(--color-text-secondary);
  }

  .docs-nav-tab--active {
    border-bottom-color: var(--color-accent);
  }

  .docs-nav-tab--active .docs-nav-tab-label {
    color: var(--color-text);
  }

  .docs-nav-tab--active .docs-nav-tab-sub {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .docs-nav-tabs { flex-wrap: wrap; }
    .docs-nav-tab { padding: 10px 14px; }
    .docs-nav-tab-label { font-size: 14px; }
    .docs-nav-tab-sub { font-size: 9px; }
  }
</style>
