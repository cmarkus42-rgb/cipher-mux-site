---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: string;
  active?: string;
}

const { lang, active } = Astro.props;
const l = lang as Lang;

const navItems = [
  { key: 'landing',  label: t(l, 'nav.home'),     href: `/${lang}/` },
  { key: 'features', label: t(l, 'nav.features'), href: `/${lang}/features` },
  { key: 'download', label: t(l, 'nav.download'), href: `/${lang}/start` },
  { key: 'docs',     label: t(l, 'nav.docs'),     href: `/${lang}/docs` },
];
---

<header class="cm-header">
  <a href={`/${lang}/`} class="cm-wordmark" aria-label="CIPHER-MUX home">CIPHER-MUX</a>
  <nav class="cm-nav" aria-label="Main navigation">
    {navItems.map(item => (
      <a
        href={item.href}
        class={active === item.key ? 'active' : undefined}
        style={active === item.key
          ? 'color: var(--color-text); border-bottom: 1.5px solid var(--color-accent); padding-bottom: 2px;'
          : undefined}
      >
        {item.label}
      </a>
    ))}
    <LangSwitch lang={lang} />
    <ThemeToggle />
  </nav>
</header>
