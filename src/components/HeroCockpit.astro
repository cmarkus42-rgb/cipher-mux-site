---
interface Props {
  label: string;
  tagline: string;
  taglineSub: string;
  taglineEnd?: string;
  subtext: string;
  buttons: Array<{ label: string; href: string; primary?: boolean }>;
  lang: string;
}

const { label, tagline, taglineSub, taglineEnd, subtext, buttons, lang } = Astro.props;

/* Parse subtext: replace {text} with <strong>text</strong> */
const subtextHtml = subtext.replace(
  /\{([^}]+)\}/g,
  '<strong>$1</strong>'
);
---

<section class="hero-v2">
  <div class="cm-grid-bg"></div>

  <!-- LEFT: copy block -->
  <div class="hero-v2__copy">
    <span class="cm-label-tag" style="align-self: flex-start;">{label}</span>

    <h1 class="hero-v2__h1">
      {tagline}<br />
      <span class="hero-v2__accent">{taglineSub}</span>
      {taglineEnd && (
        <>
          <br />
          <span class="hero-v2__dim">{taglineEnd}</span>
        </>
      )}
    </h1>

    <p class="hero-v2__sub" set:html={subtextHtml} />

    <div class="hero-v2__buttons">
      {buttons.map((btn) => (
        <a
          href={btn.href}
          class={btn.primary ? 'cm-btn cm-btn--primary' : 'cm-btn'}
          {...(btn.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {btn.label}
        </a>
      ))}
    </div>
  </div>

  <!-- RIGHT: app screenshot -->
  <div class="hero-v2__screenshot">
    <img
      class="screenshot-light"
      src="/images/screenshots/grid-empty-companion-light.png"
      alt="CIPHER-MUX — 2×2 Grid mit Companion"
      loading="eager"
    />
    <img
      class="screenshot-dark"
      src="/images/screenshots/grid-empty-companion-dark.png"
      alt="CIPHER-MUX — 2×2 Grid mit Companion"
      loading="eager"
    />
  </div>
</section>

<style>
  /* ============================================================
     HERO V2: Two-column grid with cockpit mock
     ============================================================ */
  .hero-v2 {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 540px;
    gap: 56px;
    align-items: center;
    padding: 88px 56px 96px;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
  }

  /* --- LEFT: Copy --- */
  .hero-v2__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-v2__h1 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 64px;
    line-height: 0.96;
    letter-spacing: -1px;
    margin: 0;
    color: var(--color-text);
  }

  .hero-v2__accent {
    color: var(--color-accent);
  }

  .hero-v2__dim {
    font-size: 0.62em;
    color: var(--color-text-dim);
  }

  .hero-v2__sub {
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0;
  }

  .hero-v2__sub :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero-v2__buttons {
    display: flex;
    gap: 12px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  /* --- RIGHT: App Screenshot --- */
  .hero-v2__screenshot {
    max-width: 540px;
    flex-shrink: 0;
  }

  .hero-v2__screenshot img {
    width: 100%;
    height: auto;
    border: none;
  }

  /* ============================================================
     RESPONSIVE: single column below 900px
     ============================================================ */
  @media (max-width: 900px) {
    .hero-v2 {
      grid-template-columns: 1fr;
      padding: 56px 24px 64px;
      gap: 40px;
    }

    .hero-v2__h1 {
      font-size: 48px;
    }

    .hero-v2__screenshot {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-v2__h1 {
      font-size: 38px;
    }

    .hero-v2__sub {
      font-size: 12.5px;
    }


    .mock-status {
      font-size: 8px;
    }
  }
</style>
