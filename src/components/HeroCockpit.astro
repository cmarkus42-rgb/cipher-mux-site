---
interface Props {
  label: string;
  tagline: string;
  taglineSub: string;
  taglineEnd?: string;
  subtext: string;
  buttons: Array<{ label: string; href: string; primary?: boolean }>;
  lang: string;
}

const { label, tagline, taglineSub, taglineEnd, subtext, buttons, lang } = Astro.props;
---

<section class="cm-cockpit-hero">
  <div class="cm-grid-bg"></div>

  <!-- LEFT — copy block -->
  <div class="cm-cockpit-hero__copy">
    <span class="cm-label-tag" style="align-self: flex-start;">{label}</span>
    <h1 class="cm-tagline cm-cockpit-hero__tagline">
      {tagline}<br /><span style="color: var(--color-accent);">{taglineSub}</span>{taglineEnd && <><br /><span class="cm-cockpit-hero__tagline-end">{taglineEnd}</span></>}
    </h1>
    <p class="cm-hero-sub cm-cockpit-hero__sub" set:html={subtext.replace('CIPHER-MUX', '<strong>CIPHER-MUX</strong>')} />
    <div style="display: flex; gap: 12px; margin-top: 8px;">
      {buttons.map((btn) => (
        <a
          href={btn.href}
          class={btn.primary ? 'cm-btn cm-btn--primary' : 'cm-btn'}
          {...(btn.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {btn.label}
        </a>
      ))}
    </div>
  </div>

  <!-- RIGHT — real app screenshot -->
  <div class="cm-cockpit-screenshot">
    <img class="screenshot-light" src="/images/screenshots/cipher-ivory-2x2.webp" alt="CIPHER-MUX — 2×2 Grid im cipher-ivory Theme" loading="eager" />
    <img class="screenshot-dark" src="/images/screenshots/cipher-dark-2x2.webp" alt="CIPHER-MUX — 2×2 Grid im cipher-dark Theme" loading="eager" />
  </div>
</section>
