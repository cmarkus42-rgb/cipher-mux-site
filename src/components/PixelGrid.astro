---
interface Props {
  cellSize?: number;
  gap?: number;
}

const { cellSize = 14, gap = 3 } = Astro.props;

// 9 cells: index 0–8
// Cell 5 (index 4) = center, accent full
// Cell 1 (index 0) = 0.5
// Cell 7 (index 6) = 0.4
// Cell 9 (index 8) = neon-green 0.7
// All others = dim 0.2
const cells = Array.from({ length: 9 }, (_, i) => {
  if (i === 4) return { color: 'var(--color-accent)', opacity: 1 };
  if (i === 0) return { color: 'var(--color-accent)', opacity: 0.5 };
  if (i === 6) return { color: 'var(--color-accent)', opacity: 0.4 };
  if (i === 8) return { color: 'var(--color-neon-green)', opacity: 0.7 };
  return { color: 'var(--color-border-strong)', opacity: 0.2 };
});
---

<span
  class="pixel-grid"
  style={`display:inline-grid;grid-template-columns:repeat(3,${cellSize}px);gap:${gap}px;`}
>
  {cells.map((cell) => (
    <span
      class="pixel-cell"
      style={`width:${cellSize}px;height:${cellSize}px;background:${cell.color};opacity:${cell.opacity};`}
    />
  ))}
</span>

<style>
  .pixel-cell {
    display: block;
  }
</style>
