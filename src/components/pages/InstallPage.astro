---
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: typeof import('../../i18n/de/install').default;
}

const { lang, content } = Astro.props;
const ghRelease = 'https://github.com/cmarkus42-rgb/cipher-mux-electron/releases/latest';
const ghRepo = 'https://github.com/cmarkus42-rgb/cipher-mux-electron';
---

<Layout
  title="Download & Install — CIPHER-MUX"
  description={content.hero.body}
  lang={lang}
  active="download"
>
  <div class="install-page">

    <!-- Hero -->
    <section class="install-hero">
      <div class="install-kicker">{content.hero.kicker}</div>
      <h1>{content.hero.title}<br/><span class="accent">{content.hero.titleAccent}</span> {content.hero.titleSuffix}</h1>
      <p class="install-hero-body">{content.hero.body}</p>

      <!-- Phase strip -->
      <div class="phase-strip">
        {content.phaseStrip.map((p) => (
          <div class="phase-strip-box">
            <div class="phase-strip-num">PHASE {p.n}</div>
            <div class="phase-strip-label">{p.label}</div>
            <div class="phase-strip-time">{p.time}</div>
          </div>
        ))}
      </div>

      <!-- DMG Download CTA -->
      <div class="dmg-cta">
        <a href={ghRelease} class="dmg-btn" target="_blank" rel="noopener noreferrer">{content.dmg.buttonLabel}</a>
        <span class="dmg-meta">{content.dmg.meta}</span>
      </div>

      <!-- Requirements -->
      <div class="disclosure-box">
        <div class="disclosure-label">{content.requirements.label}</div>
        <p>{content.requirements.body}</p>
      </div>
    </section>

    <!-- Phase 01 -->
    <section id="phase1" class="install-phase">
      <div class="phase-header">
        <span class="phase-header-num">{content.phases[0].headerLabel}</span>
        <span class="phase-time">{content.phases[0].headerTime}</span>
      </div>
      <h2>{content.phases[0].title}</h2>
      <p class="install-lead">{content.phases[0].lead}</p>

      <!-- Step A: DMG installieren -->
      <div class="step-block">
        <div class="step-badge-row">
          <div class="step-badge">A</div>
          <div>
            <h3>{content.stepA.title}</h3>
            <p class="step-desc">{content.stepA.desc}</p>
          </div>
        </div>

        <div class="dmg-flow-grid">
          <div class="dmg-steps-box">
            <ol class="dmg-steps">
              {content.stepA.items.map((item, i) => (
                <li>
                  <span class="dmg-step-num">{i + 1}</span>
                  <div>
                    <strong>{item.strong}</strong><br/>
                    {'linkLabel' in item && item.linkLabel ? (
                      <Fragment>
                        <a href={ghRelease} target="_blank" rel="noopener noreferrer">{item.linkLabel}</a> &rarr; <code>{'code' in item && item.code}</code>
                      </Fragment>
                    ) : 'code' in item && item.code ? (
                      <Fragment>
                        {item.detail} <code>{item.code}</code>
                      </Fragment>
                    ) : (
                      item.detail
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="dmg-mock">
            <div class="dmg-mock-chrome">
              <span class="cm-terminal-dot" style="background:#FF5F57"></span>
              <span class="cm-terminal-dot" style="background:#FEBC2E"></span>
              <span class="cm-terminal-dot" style="background:#28C840"></span>
              <span class="dmg-mock-title">cipher-mux-0.9.99</span>
            </div>
            <div class="dmg-mock-body">
              <div class="dmg-mock-icon"><img src="/images/cipher-mux-icon.png" alt="CIPHER-MUX" /></div>
              <div class="dmg-mock-arrow">&rarr;</div>
              <div class="dmg-mock-target">A</div>
            </div>
          </div>
        </div>

        <div class="pitfall-card">
          <div class="pitfall-label">{content.stepA.pitfall.label}</div>
          <ul>
            {content.stepA.pitfall.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Step B: Setup-Wizard -->
      <div class="step-block">
        <div class="step-badge-row">
          <div class="step-badge">B</div>
          <div>
            <h3>{content.stepB.title}</h3>
            <p class="step-desc">{content.stepB.desc}</p>
          </div>
        </div>

        <div class="disclosure-box">
          <div class="disclosure-label">{content.stepB.disclosureLabel}</div>
          <div class="wizard-grid">
            {content.stepB.wizardItems.map((w) => (
              <div class="wizard-item">
                <div class="wizard-item-header"><strong>{w.name}</strong> <span class="wizard-tag">{w.tag}</span></div>
                <p>{w.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="pitfall-card">
          <div class="pitfall-label">{content.stepB.pitfall.label}</div>
          <ul>
            {content.stepB.pitfall.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Step C: Claude Code einloggen -->
      <div class="step-block">
        <div class="step-badge-row">
          <div class="step-badge">C</div>
          <div>
            <h3>{content.stepC.title}</h3>
            <p class="step-desc">{content.stepC.desc}</p>
          </div>
        </div>

        <div class="cm-terminal">
          <div class="cm-terminal-bar">
            <span class="cm-terminal-dot" style="background:#FF5F57"></span>
            <span class="cm-terminal-dot" style="background:#FEBC2E"></span>
            <span class="cm-terminal-dot" style="background:#28C840"></span>
            <span class="cm-terminal-title">Terminal</span>
          </div>
          <div class="cm-terminal-body">
            <div class="t-cmd"><span class="t-prompt">$</span> {content.stepC.terminal.cmd}</div>
            <div class="t-out">{content.stepC.terminal.out}</div>
          </div>
        </div>

        <div class="pitfall-card">
          <div class="pitfall-label">{content.stepC.pitfall.label}</div>
          <ul>
            {content.stepC.pitfall.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Phase 02 -->
    <section id="phase2" class="install-phase">
      <div class="phase-header">
        <span class="phase-header-num">{content.phases[1].headerLabel}</span>
        <span class="phase-time">{content.phases[1].headerTime}</span>
      </div>
      <h2>{content.phases[1].title}</h2>
      <p class="install-lead">{content.phases[1].lead}</p>

      <div class="companion-grid">
        <!-- Left: Companion mock -->
        <div class="companion-mock">
          <div class="companion-mock-header">
            <span><span class="accent">●</span> {content.companion.mockHeader}</span>
          </div>
          <div class="companion-mock-body">
            {content.companion.mockLines.map((line) => (
              line.type === 'name' ? <div class="companion-name">{line.text}</div> :
              line.type === 'msg' ? <div class="companion-msg">{line.text}</div> :
              line.type === 'cmd' ? <div class="companion-q">{line.text}</div> :
              line.type === 'qlabel' ? <div class="companion-qlabel">{line.text}</div> :
              line.type === 'input' ? <div class="companion-input">{line.text}</div> :
              line.type === 'confirm' ? <div class="companion-confirm">{line.text}</div> :
              null
            ))}
          </div>
        </div>

        <!-- Right: Narrative -->
        <div class="companion-narrative">
          <div class="companion-narrative-title">{content.companion.narrativeTitle}</div>
          <ol class="companion-steps">
            {content.companion.narrativeSteps.map((step, i) => (
              <li><span class="companion-step-n">{i + 1}</span><div><strong>{step.strong}</strong><br/>{step.detail}</div></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Phase 03 -->
    <section id="phase3" class="install-phase">
      <div class="phase-header">
        <span class="phase-header-num">{content.nextSteps.headerLabel}</span>
        <span class="phase-time">{content.nextSteps.headerTime}</span>
      </div>
      <h2>{content.nextSteps.title} <span class="dim">{content.nextSteps.titleDim}</span></h2>
      <p class="install-lead">{content.nextSteps.lead}</p>

      <div class="nextstep-grid">
        {content.nextSteps.cards.map((card) => (
          <div class="nextstep-card">
            <span class="nextstep-guide">{card.guide}</span>
            <div class="nextstep-tag">{card.tag}</div>
            <h4>{card.title}</h4>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="install-bottom">
      <h2>{content.bottom.title} <span class="accent">{content.bottom.titleAccent}</span></h2>
      <p>{content.bottom.subtitle}</p>
      <div class="install-bottom-actions">
        <a href={ghRelease} class="dmg-btn" target="_blank" rel="noopener noreferrer">{content.bottom.dmgLabel}</a>
        <a href={ghRepo} class="install-link">{content.bottom.githubLabel}</a>
        <a href={`/${lang}/docs`} class="install-link">{content.bottom.docsLabel}</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .install-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 64px;
  }
  .accent { color: var(--color-accent); }
  .dim { color: var(--color-text-dim); }

  /* Hero */
  .install-hero {
    padding: 120px 0 48px;
    border-bottom: 1px solid var(--color-border);
  }
  .install-kicker {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }
  .install-hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(48px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -1px;
    margin: 0 0 28px;
  }
  .install-hero-body {
    font-family: 'Rajdhani', sans-serif;
    font-size: 20px;
    line-height: 1.4;
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0 0 36px;
  }

  /* Phase strip */
  .phase-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 920px;
    margin-top: 8px;
  }
  .phase-strip-box {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 14px 14px 12px;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .phase-strip-num {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 1.5px;
    margin-bottom: 6px;
  }
  .phase-strip-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
    margin-bottom: 4px;
  }
  .phase-strip-time {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-accent);
    letter-spacing: 0.8px;
  }

  /* DMG CTA */
  .dmg-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .dmg-btn {
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 22px;
    display: inline-block;
    text-decoration: none;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .dmg-btn:hover { text-decoration: none; opacity: 0.9; }
  .dmg-btn--outline {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .dmg-meta {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 0.8px;
  }

  /* Disclosure */
  .disclosure-box {
    margin-top: 28px;
    padding: 14px 18px;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    max-width: 720px;
  }
  .disclosure-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--color-accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .disclosure-box p {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0;
  }
  .wizard-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }
  .wizard-item {
    padding: 10px 14px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
  }
  .wizard-item-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
  }
  .wizard-tag {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.5px;
  }
  .wizard-item p {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 4px 0 0;
  }

  /* Phases */
  .install-phase {
    padding: 88px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .phase-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 10px;
  }
  .phase-header-num {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .phase-time {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 1px;
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .install-phase h2 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4vw, 48px);
    margin: 0 0 16px;
    line-height: 1.05;
  }
  .install-lead {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    color: var(--color-text-secondary);
    max-width: 780px;
    line-height: 1.45;
    margin: 0 0 32px;
  }

  /* Step blocks */
  .step-block { margin-bottom: 36px; }
  .step-badge-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 14px;
  }
  .step-badge {
    flex: 0 0 44px;
    height: 44px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  .step-block h3 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 26px;
    margin: 0 0 6px;
    line-height: 1.1;
  }
  .step-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
    max-width: 720px;
  }

  /* Terminal */
  .cm-terminal {
    margin: 14px 0;
    border: 1px solid var(--color-border);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    overflow: hidden;
  }
  .cm-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--color-terminal-chrome);
    border-bottom: 1px solid var(--color-border);
  }
  .cm-terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .cm-terminal-title {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    margin-left: 8px;
  }
  .cm-terminal-body {
    background: var(--color-terminal-bg);
    padding: 14px 18px;
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-terminal-text);
    overflow-x: auto;
  }
  .t-comment { color: var(--color-text-dim); font-style: italic; }
  .t-cmd { color: var(--color-terminal-text); }
  .t-prompt { color: var(--color-accent); }
  .t-out { color: var(--color-text-dim); }
  .t-spacer { height: 6px; }

  /* Pitfall card */
  .pitfall-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg-sunken);
    padding: 16px 18px;
    margin: 14px 0 0;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .pitfall-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: var(--color-warn);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .pitfall-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pitfall-card li {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    padding: 6px 0;
    border-top: 1px dotted var(--color-border);
  }
  .pitfall-card li:first-child { border-top: none; }
  .pitfall-card li::before {
    content: '\203A ';
    color: var(--color-accent);
    font-family: 'Fira Code', monospace;
    font-size: 12px;
  }
  .pitfall-card code {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-text);
  }

  /* DMG flow */
  .dmg-flow-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 18px;
    align-items: start;
  }
  .dmg-steps-box {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 18px 20px;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .dmg-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dmg-steps li {
    display: flex;
    gap: 14px;
    padding: 10px 0;
    border-top: 1px dotted var(--color-border);
  }
  .dmg-steps li:first-child { border-top: none; }
  .dmg-step-num {
    flex: 0 0 28px;
    height: 28px;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .dmg-steps strong {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text);
  }
  .dmg-steps div {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* DMG mock */
  .dmg-mock {
    background: var(--color-terminal-bg);
    border: 1px solid var(--color-border);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    overflow: hidden;
  }
  .dmg-mock-chrome {
    padding: 8px 12px;
    background: var(--color-terminal-chrome);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .dmg-mock-title {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    margin-left: 10px;
  }
  .dmg-mock-body {
    padding: 36px 24px;
    display: flex;
    align-items: center;
    justify-content: space-around;
  }
  .dmg-mock-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dmg-mock-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .dmg-mock-arrow {
    font-family: 'Rajdhani', sans-serif;
    font-size: 28px;
    color: var(--color-accent);
    opacity: 0.6;
  }
  .dmg-mock-target {
    width: 72px;
    height: 72px;
    border: 2px dashed var(--color-border);
    clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Rajdhani', sans-serif;
    font-size: 22px;
    color: var(--color-text-dim);
  }

  /* Companion mock (Phase 2) */
  .companion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 8px;
  }
  .companion-mock {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    overflow: hidden;
  }
  .companion-mock-header {
    padding: 10px 14px;
