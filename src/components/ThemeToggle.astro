<button class="cm-theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark theme"></button>

<style>
  .cm-theme-toggle {
    padding: 0;
    position: relative;
    flex-shrink: 0;
  }

  /* Left half — filled in light mode, empty in dark mode */
  .cm-theme-toggle::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: var(--color-border-strong);
    transition: background var(--transition-base);
  }

  /* Right half — empty in light mode, filled in dark mode */
  .cm-theme-toggle::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: transparent;
    transition: background var(--transition-base);
  }

  [data-theme="dark"] .cm-theme-toggle::before {
    background: transparent;
  }

  [data-theme="dark"] .cm-theme-toggle::after {
    background: var(--color-border-strong);
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }

  // Run on initial load
  initThemeToggle();

  // Re-run after Astro view transitions (if added later)
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
