<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark theme"></button>

<style>
  .theme-toggle {
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--color-border-strong);
    background: none;
    cursor: pointer;
    padding: 0;
    position: relative;
    flex-shrink: 0;
    clip-path: polygon(
      4px 0, 100% 0,
      100% calc(100% - 4px),
      calc(100% - 4px) 100%,
      0 100%, 0 4px
    );
    transition: border-color var(--transition-base);
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  /* Left half — filled in light mode, empty in dark mode */
  .theme-toggle::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: var(--color-border-strong);
    transition: background var(--transition-base);
  }

  /* Right half — empty in light mode, filled in dark mode */
  .theme-toggle::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: transparent;
    transition: background var(--transition-base);
  }

  [data-theme="dark"] .theme-toggle::before {
    background: transparent;
  }

  [data-theme="dark"] .theme-toggle::after {
    background: var(--color-border-strong);
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }

  // Run on initial load
  initThemeToggle();

  // Re-run after Astro view transitions (if added later)
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
