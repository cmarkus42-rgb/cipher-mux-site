---
import Layout from '../../../layouts/Layout.astro';
import DocsNav from '../../../components/DocsNav.astro';
import DocsHero from '../../../components/DocsHero.astro';
import DocsSection from '../../../components/DocsSection.astro';
import Callout from '../../../components/Callout.astro';
import Ladder from '../../../components/Ladder.astro';
import ScreenshotSlot from '../../../components/ScreenshotSlot.astro';
import PixelGlyph from '../../../components/PixelGlyph.astro';
import content from '../../../i18n/de/docs-konzepte';

const lang = 'de';

/* Entity → PixelGlyph name + color mapping */
const entityMeta: Record<string, { glyph: string; color: string }> = {
  'Companion':         { glyph: 'companion',    color: 'var(--color-preset-companion)' },
  'Voice Relay':       { glyph: 'voice',        color: 'var(--color-preset-voice)' },
  'Ideation Partner':  { glyph: 'ideation',     color: 'var(--color-preset-ideation)' },
  'Refinement':        { glyph: 'refinement',   color: 'var(--color-preset-refinement)' },
  'Cyber Factory':     { glyph: 'cyberFactory', color: 'var(--color-preset-cyberfactory)' },
  'Workshop':          { glyph: 'workshop',     color: 'var(--color-accent)' },
  'Testing Assistant': { glyph: 'testing',      color: 'var(--color-preset-testing)' },
  'Debugger':          { glyph: 'debugger',     color: 'var(--color-preset-debugger)' },
  'Audit':             { glyph: 'audit',        color: 'var(--color-preset-audit)' },
  'Launcher':          { glyph: 'companion',    color: 'var(--color-text-dim)' },
};

/* Phase → color mapping for pipeline */
const phaseMeta: Record<string, { glyph: string; color: string }> = {
  'Ideation Partner':  { glyph: 'ideation',     color: '#C792EA' },
  'Refinement':        { glyph: 'refinement',   color: '#BF616A' },
  'Cyber Factory':     { glyph: 'cyberFactory', color: '#5E81AC' },
  'Testing Assistant': { glyph: 'testing',      color: '#A3BE8C' },
  'Workshop':          { glyph: 'workshop',     color: '#EBCB8B' },
  'Debugger':          { glyph: 'debugger',     color: '#D08770' },
  'Audit':             { glyph: 'audit',        color: '#B48EAD' },
};

const pipelineOrder = [
  'Ideation Partner', 'Refinement', 'Cyber Factory',
  'Testing Assistant', 'Workshop', 'Debugger', 'Audit',
];
---

<Layout
  title="Prozess & Konzepte — CIPHER-MUX"
  description={content.hero.body}
  lang={lang}
  active="docs"
>
  <div class="docs-page">

    <DocsNav lang={lang} activePage="concepts" />

    <!-- Anchor Nav -->
    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">Inhalt</div>
      {content.sections.map((section) => (
        <a href={`#${section.id}`} class="cm-anchor-nav-item">
          <span class="cm-anchor-nav-num">{section.num}</span>
          <span>{section.navLabel}</span>
        </a>
      ))}
    </nav>

    <!-- Hero -->
    <DocsHero
      kicker={content.hero.kicker}
      title={content.hero.title}
      titleAccent={content.hero.titleAccent}
      body={content.hero.body}
    />

    <!-- Section 01: Die Idee -->
    <DocsSection id="idea" num="01" title="Die Idee" lead={content.idea.lead}>
      {content.idea.paragraphs.map((p) => (
        <p class="docs-p">{p}</p>
      ))}
      <Callout kind="rule" title="Wann lohnt sich der Aufwand?">
        {content.idea.callout}
      </Callout>
    </DocsSection>

    <!-- Section 02: Der Lebenszyklus -->
    <DocsSection id="lifecycle" num="02" title="Der Lebenszyklus" lead={content.lifecycle.lead}>

      <!-- Pipeline strip -->
      <div class="pipeline-strip">
        {pipelineOrder.map((name, i) => {
          const meta = phaseMeta[name];
          const isHub = name === 'Workshop';
          return (
            <>
              {i > 0 && <span class="pipeline-arrow">&rarr;</span>}
              <div class:list={['pipeline-box', { 'pipeline-box--hub': isHub }]}
                   style={`border-color: ${meta.color};`}>
                <span class="pipeline-dot" style={`background: ${meta.color};`}></span>
                <span>{name}</span>
              </div>
            </>
          );
        })}
      </div>

      <p class="docs-p">{content.lifecycle.crossCutting}</p>

      <!-- Phase detail blocks -->
      {content.lifecycle.phases.map((phase) => {
        const meta = phaseMeta[phase.label] ?? { color: 'var(--color-accent)' };
        return (
          <div class="phase-block">
            <h3 class="phase-head">
              <span class="phase-dot" style={`background: ${meta.color};`}></span>
              <span>{phase.label}</span>
            </h3>
            <div class="phase-flow" style={`border-left-color: ${meta.color};`}>
              <div class="phase-io">
                <span class="phase-io-label">EINGANG</span>
                <span class="phase-io-text">{phase.input}</span>
              </div>
              <p class="phase-process">{phase.process}</p>
              <div class="phase-io">
                <span class="phase-io-label" style={`color: ${meta.color};`}>AUSGANG</span>
                <span class="phase-io-text phase-io-text--out">{phase.output}</span>
              </div>
            </div>
          </div>
        );
      })}
    </DocsSection>

    <!-- Section 03: Die Entities im Detail -->
    <DocsSection id="entities" num="03" title="Die Entities im Detail" lead={content.entities.lead}>

      <!-- Entity list with PixelGlyphs -->
      {content.entities.items.map((item) => {
        const meta = entityMeta[item.label] ?? { glyph: 'companion', color: 'var(--color-accent)' };
        return (
          <div class="entity-block">
            <h3 class="entity-head">
              <PixelGlyph name={meta.glyph} color={meta.color} size={36} />
              <span>{item.label}</span>
            </h3>
            <div class="entity-desc" style={`border-left-color: ${meta.color};`}>
              <p class="docs-p">{item.desc}</p>
            </div>
          </div>
        );
      })}

      <!-- Decision table -->
      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.entities.decisionTitle}</span></h3>
      <div class="docs-table">
        <div class="docs-table-header docs-table-2col">
          <div>Situation</div><div>Entity</div>
        </div>
        {content.entities.decisionRows.map((row, i) => (
          <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
            <div class="docs-table-desc">{row.situation}</div>
            <div class="docs-table-label">{row.entity}</div>
          </div>
        ))}
      </div>
    </DocsSection>

    <!-- Section 04: Presets verstehen -->
    <DocsSection id="presets" num="04" title="Presets verstehen" lead={content.presets.lead}>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>Die fuenf Schichten</span></h3>
      <p class="docs-p">{content.presets.layersIntro}</p>

      <Ladder rungs={content.presets.layers.map(l => ({
        label: l.label,
        priority: l.prio,
        desc: l.desc,
      }))} />

      <Callout kind="rule" title="Variabilitaet">
        {content.presets.variability}
      </Callout>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.presets.folderTitle}</span></h3>
      <p class="docs-p" set:html={content.presets.folderDesc} />
      <ul class="docs-list">
        {content.presets.folderItems.map((item) => (
          <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
        ))}
      </ul>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.presets.builtinTitle}</span></h3>
      <p class="docs-p">{content.presets.builtinDesc}</p>

      <ScreenshotSlot
        src="/images/screenshots/preset-editor"
        caption={content.presets.screenshot.caption}
        placeholder={content.presets.screenshot.placeholder}
      />
    </DocsSection>

    <!-- Section 05: Personas -->
    <DocsSection id="personas" num="05" title="Personas (Characters)" lead={content.personas.lead}>

      <div class="docs-table">
        <div class="docs-table-header docs-table-2col">
          <div>Persona</div><div>Charakter</div>
        </div>
        {content.personas.items.map((item, i) => (
          <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
            <div class="docs-table-label">{item.label}</div>
            <div class="docs-table-desc">{item.desc}</div>
          </div>
        ))}
      </div>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.personas.globalTitle}</span></h3>
      <p class="docs-p">{content.personas.globalDesc}</p>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.personas.customTitle}</span></h3>
      <p class="docs-p">{content.personas.customDesc}</p>

      <ScreenshotSlot
        src="/images/screenshots/persona-editor"
        caption={content.personas.screenshot.caption}
        placeholder={content.personas.screenshot.placeholder}
      />
    </DocsSection>

    <!-- Section 06: Memory, Tags & Scoping -->
    <DocsSection id="memory" num="06" title="Memory, Tags & Workspace-Scoping" lead={content.memory.lead}>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.memory.memoryTitle}</span></h3>
      <p class="docs-p">{content.memory.memoryDesc}</p>
      <div class="docs-table">
        <div class="docs-table-header docs-table-2col">
          <div>Scope</div><div>Geltungsbereich</div>
        </div>
        {content.memory.memoryScopes.map((scope, i) => (
          <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
            <div class="docs-table-label">{scope.label}</div>
            <div class="docs-table-desc">{scope.desc}</div>
          </div>
        ))}
      </div>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.memory.notesTitle}</span></h3>
      <p class="docs-p">{content.memory.notesDesc}</p>

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.memory.tagsTitle}</span></h3>
      <p class="docs-p" set:html={content.memory.tagsDesc} />

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.memory.scopingTitle}</span></h3>
      <p class="docs-p" set:html={content.memory.scopingDesc} />

      <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.memory.comparisonTitle}</span></h3>
      <div class="docs-table">
        <div class="docs-table-header docs-table-3col">
          <div>Aspekt</div><div>Note</div><div>Memory</div>
        </div>
        {content.memory.comparisonRows.map((row, i) => (
          <div class:list={["docs-table-row", "docs-table-3col", { "docs-table-row-first": i === 0 }]}>
            <div class="docs-table-key">{row.aspect}</div>
            <div class="docs-table-label-mid">{row.note}</div>
            <div class="docs-table-desc">{row.mem}</div>
          </div>
        ))}
      </div>
    </DocsSection>

    <!-- Section 07: Ehrlichkeit -->
    <DocsSection id="honesty" num="07" title="Ehrlichkeit" lead={content.honesty.lead}>

      <div class="honesty-grid">
        {content.honesty.items.map((item, i) => (
          <div class="honesty-card">
            <div class="honesty-card-header">
              <span class="honesty-card-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="honesty-card-label">{item.label}</span>
            </div>
            <p class="honesty-card-text">{item.text}</p>
          </div>
        ))}
      </div>

      <p class="docs-p docs-p--italic">{content.honesty.closing}</p>
    </DocsSection>

    <!-- Bottom CTA -->
    <section class="docs-bottom">
      <div class="docs-inner">
        <h2>{content.bottom.title} <span class="accent">{content.bottom.titleAccent}</span></h2>
        <p class="docs-bottom-body">{content.bottom.body}</p>
        <div class="docs-bottom-actions">
          <a href={content.bottom.usageHref} class="cm-btn cm-btn--primary">&rarr; {content.bottom.usageLabel}</a>
          <a href={`/${lang}/start`} class="docs-bottom-link">&darr; {content.bottom.downloadLabel}</a>
          <a
            href="https://github.com/cmarkus42-rgb/cipher-mux-electron"
            class="docs-bottom-link"
            target="_blank"
            rel="noopener noreferrer"
          >{content.bottom.githubLabel} &nearr;</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('[id]');
      const navItems = document.querySelectorAll('.cm-anchor-nav-item');
      const sectionIds = new Set(Array.from(navItems).map(a => a.getAttribute('href')?.slice(1)));
      const observed = Array.from(sections).filter(s => sectionIds.has(s.id));

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navItems.forEach(item => item.classList.remove('active'));
            const id = entry.target.id;
            const activeItem = document.querySelector(`.cm-anchor-nav-item[href="#${id}"]`);
            if (activeItem) activeItem.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      observed.forEach(s => observer.observe(s));
    });
  </script>
</Layout>

<style>
  /* --- Page Layout --- */
  .docs-page {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
  }

  /* --- Anchor Nav --- */
  .cm-anchor-nav {
    position: fixed;
    top: 140px;
    right: 32px;
    width: 180px;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 10;
  }

  .cm-anchor-nav-label {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 9px;
  }

  .cm-anchor-nav-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 2px 4px;
    color: var(--color-text-dim);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1.4;
  }

  .cm-anchor-nav-item:hover,
  .cm-anchor-nav-item.active {
    color: var(--color-text);
    border-left-color: var(--color-accent);
  }

  .cm-anchor-nav-num {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 1200px) {
    .cm-anchor-nav { display: none; }
  }

  /* --- Body Paragraph --- */
  .docs-p {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0 0 12px;
  }

  .docs-p :global(strong) { color: var(--color-text); font-weight: 600; }
  .docs-p--italic { font-style: italic; }

  /* --- Inline Mono --- */
  :global(.docs-mono) {
    font-family: 'Fira Code', monospace;
    font-size: 12.5px;
    background: var(--color-bg-elevated);
    color: var(--color-text);
    padding: 1px 6px;
    border: 1px solid var(--color-border);
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }

  /* --- Subhead --- */
  .docs-subhead {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin: 28px 0 12px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .docs-subhead-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    flex-shrink: 0;
    transform: translateY(1px);
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }

  /* --- List --- */
  .docs-list {
    margin: 8px 0 16px;
    padding: 0;
    list-style: none;
  }

  .docs-list li {
    display: flex;
    gap: 12px;
    padding: 5px 0;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .docs-list li :global(strong) { color: var(--color-text); font-weight: 600; }

  .docs-list-marker {
    color: var(--color-accent);
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* --- Pipeline Strip --- */
  .pipeline-strip {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 16px 0 24px;
    flex-wrap: wrap;
  }

  .pipeline-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 13.5px;
    color: var(--color-text);
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    white-space: nowrap;
  }

  .pipeline-box--hub {
    background: var(--color-bg-elevated);
    font-weight: 700;
  }

  .pipeline-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  .pipeline-arrow {
    display: flex;
    align-items: center;
    padding: 0 6px;
    color: var(--color-text-dim);
    font-family: 'Fira Code', monospace;
    font-size: 13px;
  }

  /* --- Phase Detail Blocks --- */
  .phase-block {
    margin-bottom: 10px;
  }

  .phase-head {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.15;
    margin: 24px 0 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .phase-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }

  .phase-flow {
    border-left: 2px solid var(--color-border);
    padding-left: 22px;
    margin-left: 4px;
    margin-bottom: 12px;
  }

  .phase-io {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 4px 0;
  }

  .phase-io-label {
    font-family: 'Fira Code', monospace;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  .phase-io-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .phase-io-text--out {
    font-weight: 700;
    color: var(--color-text);
  }

  .phase-process {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 6px 0;
    max-width: 720px;
  }

  /* --- Entity Blocks --- */
  .entity-block {
    margin-bottom: 6px;
  }

  .entity-head {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.15;
    margin: 22px 0 6px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .entity-desc {
    border-left: 2px solid var(--color-border);
    padding-left: 22px;
    margin-left: 11px;
    margin-bottom: 8px;
  }

  .entity-desc .docs-p {
    margin: 0;
  }

  /* --- Table --- */
  .docs-table {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    margin: 8px 0 18px;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    overflow: hidden;
    overflow-x: auto;
  }

  .docs-table-header {
    background: var(--color-border-strong);
    border-bottom: 1px solid var(--color-border);
    padding: 10px 16px;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bg-elevated);
  }

  .docs-table-2col {
    display: grid;
    grid-template-columns: 1fr 2fr;
  }

  .docs-table-3col {
    display: grid;
    grid-template-columns: 1fr 1.2fr 2fr;
  }

  .docs-table-row {
    padding: 12px 16px;
    gap: 16px;
    align-items: baseline;
  }

  .docs-table-row:not(.docs-table-row-first) {
    border-top: 1px dotted var(--color-border);
  }

  .docs-table-label {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .docs-table-key {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .docs-table-label-mid {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: var(--color-text);
  }

  .docs-table-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14.5px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  /* --- Honesty Cards --- */
  .honesty-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0 24px;
    max-width: 760px;
  }

  .honesty-card {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-warn);
    background: var(--color-bg-sunken);
    padding: 14px 18px;
  }

  .honesty-card-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
  }

  .honesty-card-num {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: var(--color-warn);
    letter-spacing: 0.06em;
  }

  .honesty-card-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text);
  }

  .honesty-card-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
