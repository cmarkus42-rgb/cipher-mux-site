---
import Layout from '../../../layouts/Layout.astro';
import DocsNav from '../../../components/DocsNav.astro';
import content from '../../../i18n/de/docs-start';

const lang = 'de';
---

<Layout
  title="Schnelleinstieg — CIPHER-MUX"
  description={content.hero.body}
  lang={lang}
  active="docs"
>
  <div class="docs-page">

    <DocsNav lang={lang} activePage="start" />

    <!-- Anchor Nav -->
    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">Inhalt</div>
      {content.sections.map((section) => (
        <a href={`#${section.id}`} class="cm-anchor-nav-item">
          <span class="cm-anchor-nav-num">{section.num}</span>
          <span>{section.navLabel}</span>
        </a>
      ))}
    </nav>

    <!-- Hero -->
    <section class="docs-hero">
      <div class="cm-tag">{content.hero.kicker}</div>
      <h1>{content.hero.title}<br /><span class="accent">{content.hero.titleAccent}</span></h1>
      <p class="docs-body">{content.hero.body}</p>
    </section>

    <!-- ═══ §01 · Orientierung ═══ -->
    <section id="orientation" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 01</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Orientierung</h2>
        <p class="docs-lead">{content.orientation.lead}</p>

        <ul class="docs-list">
          {content.orientation.items.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.orientation.screenshot.placeholder}</div>
          <figcaption>{content.orientation.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §02 · Workspace anlegen ═══ -->
    <section id="workspace" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 02</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Workspace anlegen</h2>
        <p class="docs-lead">{content.workspace.lead}</p>

        <ul class="docs-list">
          {content.workspace.flow.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <div class="docs-callout docs-callout-rule">
          <div class="docs-callout-label">Kernkonzept</div>
          <div class="docs-callout-body">{content.workspace.callout}</div>
        </div>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.workspace.screenshot.placeholder}</div>
          <figcaption>{content.workspace.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §03 · Sessions starten ═══ -->
    <section id="sessions" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 03</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Sessions starten</h2>
        <p class="docs-lead">{content.sessions.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.sessions.presetTitle}</span></h3>
        <ul class="docs-list">
          {content.sessions.presetSteps.map((step) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={step} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.sessions.pathTitle}</span></h3>
        <ul class="docs-list">
          {content.sessions.pathSteps.map((step) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={step} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.sessions.optionsTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col">
            <div>Option</div><div>Bedeutung</div>
          </div>
          {content.sessions.options.map((opt, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{opt.label}</div>
              <div class="docs-table-desc">{opt.desc}</div>
            </div>
          ))}
        </div>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.sessions.screenshot.placeholder}</div>
          <figcaption>{content.sessions.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §04 · Die App im Ueberblick ═══ -->
    <section id="overview" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 04</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Die App im Ueberblick</h2>
        <p class="docs-lead">{content.overview.lead}</p>

        <div class="docs-table">
          <div class="docs-table-header docs-table-2col">
            <div>Bereich</div><div>Was du dort findest</div>
          </div>
          {content.overview.areas.map((area, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{area.label}</div>
              <div class="docs-table-desc">{area.desc}</div>
            </div>
          ))}
        </div>

        <div class="docs-callout docs-callout-tip">
          <div class="docs-callout-label">Details</div>
          <div class="docs-callout-body" set:html={content.overview.callout} />
        </div>
      </div>
    </section>

    <!-- ═══ §05 · Voice ausprobieren ═══ -->
    <section id="voice" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 05</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Voice ausprobieren</h2>
        <p class="docs-lead">{content.voice.lead}</p>

        <ul class="docs-list">
          {content.voice.items.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <p class="docs-p">{content.voice.linkNote} <a href={content.voice.linkHref} class="docs-inline-link">{content.voice.linkLabel}</a>.</p>
      </div>
    </section>

    <!-- ═══ §06 · Weiter ═══ -->
    <section id="next" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">§ 06</span>
          <span class="cm-section-header-line"></span>
          <span>schritt</span>
        </div>
        <h2>Weiter</h2>
        <p class="docs-lead">{content.next.lead}</p>

        <div class="docs-next-cards">
          <a href={content.next.concepts.href} class="docs-next-card">
            <h3>{content.next.concepts.title}</h3>
            <p>{content.next.concepts.body}</p>
            <div class="docs-next-card-arrow">&rarr;</div>
          </a>
          <a href={content.next.usage.href} class="docs-next-card">
            <h3>{content.next.usage.title}</h3>
            <p>{content.next.usage.body}</p>
            <div class="docs-next-card-arrow">&rarr;</div>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ Bottom CTA ═══ -->
    <section class="docs-bottom">
      <div class="docs-inner">
        <h2>{content.bottom.title} <span class="accent">{content.bottom.titleAccent}</span></h2>
        <p class="docs-bottom-body">{content.bottom.body}</p>
        <div class="docs-bottom-actions">
          <a href={`/${lang}/start`} class="cm-btn cm-btn--primary">&darr; {content.bottom.downloadLabel}</a>
          <a
            href="https://github.com/cmarkus42-rgb/cipher-mux-electron"
            class="docs-bottom-link"
            target="_blank"
            rel="noopener noreferrer"
          >{content.bottom.githubLabel} &nearr;</a>
        </div>
      </div>
    </section>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.docs-section');
      const navItems = document.querySelectorAll('.cm-anchor-nav-item');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navItems.forEach(item => item.classList.remove('active'));
            const id = entry.target.id;
            const activeItem = document.querySelector(`.cm-anchor-nav-item[href="#${id}"]`);
            if (activeItem) activeItem.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      sections.forEach(s => observer.observe(s));
    });
  </script>
</Layout>

<style>
  /* ─── Page Layout ─── */
  .docs-page {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 64px;
  }

  .docs-inner {
    max-width: 920px;
  }

  /* ─── Hero ─── */
  .docs-hero {
    padding: 120px 0 48px;
    border-bottom: 1px solid var(--color-border);
  }

  .cm-tag {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 16px;
  }

  .docs-hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }

  .accent { color: var(--color-accent); }

  .docs-body {
    font-family: 'Rajdhani', sans-serif;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 720px;
  }

  /* ─── Anchor Nav ─── */
  .cm-anchor-nav {
    position: fixed;
    top: 140px;
    right: 32px;
    width: 180px;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 10;
  }

  .cm-anchor-nav-label {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 9px;
  }

  .cm-anchor-nav-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 2px 4px;
    color: var(--color-text-dim);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1.4;
  }

  .cm-anchor-nav-item:hover,
  .cm-anchor-nav-item.active {
    color: var(--color-text);
    border-left-color: var(--color-accent);
  }

  .cm-anchor-nav-num {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 1200px) {
    .cm-anchor-nav { display: none; }
  }

  /* ─── Section Shell ─── */
  .docs-section {
    padding: 64px 0;
    border-top: 1px solid var(--color-border);
  }

  .cm-section-header-meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-text-dim);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .cm-section-header-num { color: var(--color-accent); }

  .cm-section-header-line {
    flex: 0 0 14px;
    height: 1px;
    background: var(--color-border);
    align-self: center;
  }

  .docs-section h2 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 2.5vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  .docs-lead {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 720px;
    margin: 0 0 28px;
  }

  /* ─── Subhead ─── */
  .docs-subhead {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin: 28px 0 12px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .docs-subhead-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    flex-shrink: 0;
    transform: translateY(1px);
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }

  /* ─── Body Paragraph ─── */
  .docs-p {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0 0 12px;
  }

  .docs-p :global(strong) { color: var(--color-text); font-weight: 600; }

  /* ─── Inline Mono ─── */
  :global(.docs-mono) {
    font-family: 'Fira Code', monospace;
    font-size: 12.5px;
    background: var(--color-bg-elevated);
    color: var(--color-text);
    padding: 1px 6px;
    border: 1px solid var(--color-border);
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }

  /* ─── Inline Link ─── */
  .docs-inline-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-accent);
    padding-bottom: 1px;
  }

  .docs-inline-link:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  /* ─── Table ─── */
  .docs-table {
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    margin: 8px 0 18px;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    overflow: hidden;
    overflow-x: auto;
  }

  .docs-table-header {
    background: var(--color-border-strong);
    border-bottom: 1px solid var(--color-border);
    padding: 10px 16px;
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bg-elevated);
  }

  .docs-table-2col {
    display: grid;
    grid-template-columns: 1fr 2fr;
  }

  .docs-table-3col {
    display: grid;
    grid-template-columns: 1fr 1.2fr 2fr;
  }

  .docs-table-row {
    padding: 12px 16px;
    gap: 16px;
    align-items: baseline;
  }

  .docs-table-row:not(.docs-table-row-first) {
    border-top: 1px dotted var(--color-border);
  }

  .docs-table-label {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .docs-table-key {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .docs-table-label-mid {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: var(--color-text);
  }

  .docs-table-desc {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14.5px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  /* ─── List ─── */
  .docs-list {
    margin: 8px 0 16px;
    padding: 0;
    list-style: none;
  }

  .docs-list li {
    display: flex;
    gap: 12px;
    padding: 5px 0;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .docs-list li :global(strong) { color: var(--color-text); font-weight: 600; }

  .docs-list-marker {
    color: var(--color-accent);
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ─── Callout ─── */
  .docs-callout {
    margin: 14px 0 18px;
    padding: 14px 18px 14px 16px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    max-width: 760px;
  }

  .docs-callout-tip { border-left: 3px solid var(--color-accent); }
  .docs-callout-warn { border-left: 3px solid var(--color-warn); }
  .docs-callout-rule { border-left: 3px solid var(--color-text); }

  .docs-callout-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .docs-callout-tip .docs-callout-label { color: var(--color-accent); }
  .docs-callout-warn .docs-callout-label { color: var(--color-warn); }
  .docs-callout-rule .docs-callout-label { color: var(--color-text); }

  .docs-callout-body {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    color: var(--color-text);
    line-height: 1.5;
  }

  .docs-callout-body :global(strong) { font-weight: 600; }

  /* ─── Screenshot Placeholder ─── */
  .docs-screenshot { margin: 1.5rem 0; }
  .docs-screenshot-placeholder {
    background: var(--color-bg-sunken);
    border: 2px dashed var(--color-border);
    padding: 3rem 2rem;
    text-align: center;
    color: var(--color-text-dim);
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    font-style: italic;
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  .docs-screenshot figcaption {
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    color: var(--color-text-dim);
    margin-top: 6px;
  }

  /* ─── Next Cards ─── */
  .docs-next-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 12px;
  }

  .docs-next-card {
    display: flex;
    flex-direction: column;
    padding: 24px 22px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    transition: border-color 0.15s;
  }

  .docs-next-card:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .docs-next-card h3 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.15;
    margin: 0 0 8px;
  }

  .docs-next-card p {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.45;
    flex: 1;
    margin: 0;
  }

  .docs-next-card-arrow {
    font-family: 'Fira Code', monospace;
    font-size: 16px;
    color: var(--color-accent);
    margin-top: 14px;
    align-self: flex-end;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .docs-next-card:hover .docs-next-card-arrow { opacity: 1; }

  /* ─── Bottom CTA ─── */
  .docs-bottom {
    padding: 64px 64px;
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    margin: 0 -64px;
  }

  .docs-bottom h2 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }

  .docs-bottom-body {
    font-family: 'Rajdhani', sans-serif;
    font-size: 17px;
    color: var(--color-text-secondary);
    max-width: 640px;
    line-height: 1.5;
    margin: 0 0 22px;
  }

  .docs-bottom-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .docs-bottom-link {
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-text-dim);
    padding-bottom: 2px;
  }

  .docs-bottom-link:hover { color: var(--color-text); }

  /* ─── Buttons ─── */
  .cm-btn {
    display: inline-block;
    padding: 12px 20px;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }

  .cm-btn--primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .cm-btn--primary:hover { opacity: 0.88; }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .docs-page { padding: 0 20px; }
    .docs-hero { padding: 80px 0 40px; }
    .docs-section { padding: 48px 0; }
    .docs-bottom { padding: 32px 20px; margin: 0 -20px; }
    .docs-table-2col { grid-template-columns: 1fr; gap: 4px; }
    .docs-table-3col { grid-template-columns: 1fr; gap: 4px; }
    .docs-table-label, .docs-table-desc, .docs-table-key, .docs-table-label-mid { word-break: break-word; }
    .docs-next-cards { grid-template-columns: 1fr; }
  }
</style>
