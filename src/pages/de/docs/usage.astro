---
import Layout from '../../../layouts/Layout.astro';
import DocsNav from '../../../components/DocsNav.astro';
import content from '../../../i18n/de/docs-nutzung';

const lang = 'de';
---

<Layout
  title="Nutzung der App — CIPHER-MUX"
  description={content.hero.body}
  lang={lang}
  active="docs"
>
  <div class="docs-page">

    <DocsNav lang={lang} activePage="usage" />

    <!-- Anchor Nav -->
    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">Inhalt</div>
      {content.sections.map((section) => (
        <a href={`#${section.id}`} class="cm-anchor-nav-item">
          <span class="cm-anchor-nav-num">{section.num}</span>
          <span>{section.navLabel}</span>
        </a>
      ))}
    </nav>

    <!-- Hero -->
    <section class="docs-hero">
      <div class="cm-tag">{content.hero.kicker}</div>
      <h1>{content.hero.title}<br /><span class="accent">{content.hero.titleAccent}</span></h1>
      <p class="docs-body">{content.hero.body}</p>
    </section>

    <!-- ═══ §01 · Das Grid ═══ -->
    <section id="grid" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 01</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Das Grid</h2>
        <p class="docs-lead">{content.grid.lead}</p>

        {content.grid.mainParagraphs.map((p) => (
          <p class="docs-p" set:html={p} />
        ))}

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.grid.dragTitle}</span></h3>
        <ul class="docs-list">
          {content.grid.dragItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.grid.sizeTitle}</span></h3>
        <ul class="docs-list">
          {content.grid.sizeItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.grid.layoutsTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Layout</div><div>Wofuer</div></div>
          {content.grid.layouts.map((l, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{l.label}</div>
              <div class="docs-table-desc">{l.desc}</div>
            </div>
          ))}
        </div>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.grid.screenshot.placeholder}</div>
          <figcaption>{content.grid.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §02 · Session-Zell-Header ═══ -->
    <section id="header" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 02</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Session-Zell-Header</h2>
        <p class="docs-lead">{content.header.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.header.leftTitle}</span></h3>
        <ul class="docs-list">
          {content.header.leftItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.header.contextTitle}</span></h3>
        <p class="docs-p">{content.header.contextDesc}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.header.buttonsTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-3col"><div>Icon</div><div>Aktion</div><div>Beschreibung</div></div>
          {content.header.buttons.map((b, i) => (
            <div class:list={["docs-table-row", "docs-table-3col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-key">{b.icon}{b.shortcut ? ` / ${b.shortcut}` : ''}</div>
              <div class="docs-table-label-mid">{b.label}</div>
              <div class="docs-table-desc">{b.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.header.entityTitle}</span></h3>
        <div class="docs-table docs-table-compact">
          <div class="docs-table-header docs-table-2col"><div>Entity</div><div>Farbe</div></div>
          {content.header.entities.map((e, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{e.label}</div>
              <div class="docs-table-desc">{e.color}</div>
            </div>
          ))}
        </div>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.header.screenshot.placeholder}</div>
          <figcaption>{content.header.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §03 · Focus Mode und Pop-Out ═══ -->
    <section id="focus" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 03</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Focus Mode &amp; Pop-Out</h2>
        <p class="docs-lead">{content.focus.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.focus.focusTitle}</span></h3>
        <ul class="docs-list">
          {content.focus.focusItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.focus.popoutTitle}</span></h3>
        <ul class="docs-list">
          {content.focus.popoutItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.focus.sidebarTitle}</span></h3>
        <p class="docs-p">{content.focus.sidebarDesc}</p>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.focus.screenshot.placeholder}</div>
          <figcaption>{content.focus.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §04 · Die Sidebar ═══ -->
    <section id="sidebar" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 04</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Die Sidebar</h2>
        <p class="docs-lead">{content.sidebar.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.sidebar.sectionsTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Sektion</div><div>Inhalt</div></div>
          {content.sidebar.sections.map((s, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{s.label}</div>
              <div class="docs-table-desc">{s.desc}</div>
            </div>
          ))}
        </div>

        <div class="docs-callout docs-callout-tip">
          <div class="docs-callout-label">Tipp</div>
          <div class="docs-callout-body">{content.sidebar.detachTip}</div>
        </div>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.sidebar.screenshot.placeholder}</div>
          <figcaption>{content.sidebar.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §05 · Sprachsteuerung ═══ -->
    <section id="voice" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 05</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Sprachsteuerung</h2>
        <p class="docs-lead">{content.voice.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.modesTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Modus</div><div>Beschreibung</div></div>
          {content.voice.modes.map((m, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{m.label}</div>
              <div class="docs-table-desc">{m.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.ledTitle}</span></h3>
        <div class="docs-led-row">
          {content.voice.leds.map((led) => (
            <div class="docs-led-item">
              <span class={`docs-led-dot docs-led-${led.css}`}></span>
              <span class="docs-led-label">{led.label}</span>
              <span class="docs-led-desc">{led.desc}</span>
            </div>
          ))}
        </div>

        <div class="docs-callout docs-callout-rule">
          <div class="docs-callout-label">Faustregel &middot; Wichtig</div>
          <div class="docs-callout-body">Gesprochener Text wird eingefuegt aber <em>nicht automatisch gesendet</em>. Du kannst lesen, korrigieren, dann per <span class="docs-mono">"abschicken"</span> oder Enter senden.</div>
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.textTitle}</span></h3>
        <div class="docs-table docs-table-compact">
          <div class="docs-table-header docs-table-2col"><div>Sage</div><div>Bewirkt</div></div>
          {content.voice.textCommands.map((c, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{c.cmd}</div>
              <div class="docs-table-desc">{c.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.scrollTitle}</span></h3>
        <div class="docs-table docs-table-compact">
          <div class="docs-table-header docs-table-2col"><div>Sage</div><div>Bewirkt</div></div>
          {content.voice.scrollCommands.map((c, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{c.cmd}</div>
              <div class="docs-table-desc">{c.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.gridNavTitle}</span></h3>
        <div class="docs-table docs-table-compact">
          <div class="docs-table-header docs-table-2col"><div>Sage</div><div>Bewirkt</div></div>
          {content.voice.gridNavCommands.map((c, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{c.cmd}</div>
              <div class="docs-table-desc">{c.desc}</div>
            </div>
          ))}
        </div>
        <p class="docs-p" set:html={content.voice.gridNavNote} />

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.comTitle}</span></h3>
        {content.voice.comParagraphs.map((p) => (
          <p class="docs-p">{p}</p>
        ))}

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.pinTitle}</span></h3>
        <p class="docs-p">{content.voice.pinDesc}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.ttsTitle}</span></h3>
        <ul class="docs-list">
          {content.voice.ttsItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.voice.btTitle}</span></h3>
        <ul class="docs-list">
          {content.voice.btItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <figure class="docs-screenshot">
          <div class="docs-screenshot-placeholder">{content.voice.screenshot.placeholder}</div>
          <figcaption>{content.voice.screenshot.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ §06 · Notes ═══ -->
    <section id="notes" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 06</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Notes</h2>
        <p class="docs-lead">{content.notes.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.createTitle}</span></h3>
        <ul class="docs-list">
          {content.notes.createItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.editorTitle}</span></h3>
        <ul class="docs-list">
          {content.notes.editorItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.saveTitle}</span></h3>
        <ul class="docs-list">
          {content.notes.saveItems.map((item) => (
            <li><span class="docs-list-marker">&rsaquo;</span><span set:html={item} /></li>
          ))}
        </ul>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.voiceTitle}</span></h3>
        <p class="docs-p">{content.notes.voiceDesc}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.scopingTitle}</span></h3>
        <p class="docs-p" set:html={content.notes.scopingDesc} />

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.handoffTitle}</span></h3>
        <p class="docs-p" set:html={content.notes.handoffDesc} />

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.testcaseTitle}</span></h3>
        <p class="docs-p" set:html={content.notes.testcaseDesc} />

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.notes.comparisonTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-3col">
            <div>Aspekt</div><div>Note</div><div>Memory</div>
          </div>
          {content.notes.comparisonRows.map((row, i) => (
            <div class:list={["docs-table-row", "docs-table-3col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-key">{row.aspect}</div>
              <div class="docs-table-label-mid">{row.note}</div>
              <div class="docs-table-desc">{row.mem}</div>
            </div>
          ))}
        </div>

        <div class="docs-screenshot-row">
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-notes-editor.webp" alt="Notes-Editor mit Feature-Spec" loading="lazy" />
            <span>Notes-Editor</span>
          </div>
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-testcase-view.webp" alt="Testcase-View" loading="lazy" />
            <span>Testcase-View</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ §07 · Projekte und Hub ═══ -->
    <section id="projects" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 07</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Projekte und Hub</h2>
        <p class="docs-lead">{content.projects.lead}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.projects.structureTitle}</span></h3>
        <pre class="docs-terminal">projekt-name/
  .claude/              <span class="dim">Claude Code Config</span>
  .cyber-factory/       <span class="dim">Run-Konfiguration</span>
  docs/specs/           <span class="dim">Detail-Specs mit REQ-IDs</span>
  docs/decisions/       <span class="dim">ADRs (Architektur-Entscheidungen)</span>
  docs/research/        <span class="dim">Recherche aus Ideation Partner</span>
  docs/audit/           <span class="dim">Audit-Berichte</span>
  src/                  <span class="dim">Quellcode</span>
  tests/                <span class="dim">Tests</span>
  .project-meta.json    <span class="dim">Phase, Workspace, Tags, Verwendungszweck</span></pre>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.projects.adoptionTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Modus</div><div>Was passiert</div></div>
          {content.projects.adoptionModes.map((m, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{m.label}</div>
              <div class="docs-table-desc">{m.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ §08 · Einstellungen ═══ -->
    <section id="settings" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 08</span>
          <span class="cm-section-header-line"></span>
          <span>kapitel</span>
        </div>
        <h2>Einstellungen</h2>
        <p class="docs-lead">{content.settings.lead}</p>

        <div class="docs-tab-strip">
          {content.settings.tabs.map((tab, i) => (
            <div class:list={["docs-tab", { "docs-tab-active": i === 0 }]}>{tab}</div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.generalTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Option</div><div>Beschreibung</div></div>
          {content.settings.generalRows.map((r, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{r.label}</div>
              <div class="docs-table-desc">{r.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.languageTitle}</span></h3>
        <div class="docs-table">
          <div class="docs-table-header docs-table-2col"><div>Bereich</div><div>Optionen</div></div>
          {content.settings.languageRows.map((r, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{r.label}</div>
              <div class="docs-table-desc">{r.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.themesTitle}</span></h3>
        <p class="docs-p">{content.settings.themesIntro}</p>

        {content.settings.themeCategories.map((cat) => (
          <div class="docs-theme-category">
            <p class="docs-p"><strong>{cat.category}</strong></p>
            <div class="docs-table docs-table-compact">
              <div class="docs-table-header docs-table-2col"><div>Theme</div><div>Charakter</div></div>
              {cat.themes.map((t, i) => (
                <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
                  <div class="docs-table-label">{t.label}</div>
                  <div class="docs-table-desc">{t.desc}</div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.editorTitle}</span></h3>
        <div class="docs-table docs-table-compact">
          <div class="docs-table-header docs-table-2col"><div>Aktion</div><div>Was passiert</div></div>
          {content.settings.editorRows.map((r, i) => (
            <div class:list={["docs-table-row", "docs-table-2col", { "docs-table-row-first": i === 0 }]}>
              <div class="docs-table-label">{r.label}</div>
              <div class="docs-table-desc">{r.desc}</div>
            </div>
          ))}
        </div>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.shortcutsTitle}</span></h3>
        <p class="docs-p">{content.settings.shortcutsDesc}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.a11yTitle}</span></h3>
        <p class="docs-p">{content.settings.a11yDesc}</p>

        <h3 class="docs-subhead"><span class="docs-subhead-dot"></span><span>{content.settings.aboutTitle}</span></h3>
        <p class="docs-p">{content.settings.aboutDesc}</p>

        <div class="docs-screenshot-row docs-screenshot-row--4">
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-settings-general.webp" alt="Allgemein" loading="lazy" />
            <span>Allgemein</span>
          </div>
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-settings-themes.webp" alt="Themes" loading="lazy" />
            <span>Themes</span>
          </div>
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-settings-a11y.webp" alt="A11y" loading="lazy" />
            <span>Barrierefreiheit</span>
          </div>
          <div class="docs-screenshot-sm">
            <img src="/images/screenshots/detail-settings-models.webp" alt="Models" loading="lazy" />
            <span>LLM-Provider</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ §09 · Bugreport-Dialog ═══ -->
    <section id="bugreport" class="docs-section">
      <div class="docs-inner">
        <div class="cm-section-header-meta">
          <span class="cm-section-header-num">&sect; 09</span>
          <span class="cm-section-header-line"></span>
