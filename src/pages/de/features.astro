---
import Layout from '../../layouts/Layout.astro';
import content from '../../i18n/de/features';
import { t } from '../../i18n/ui';

const lang = 'de';

const sectionIdMap: Record<string, string> = {
  '01': 'cockpit',
  '02': 'grid',
  '03': 'sessions',
  '04': 'presets',
  '05': 'personas',
  '06': 'prompts',
  '07': 'voice',
  '08': 'notes',
  '09': 'mcp',
  '10': 'themes',
  '11': 'efficiency',
};

type SectionWithStats = typeof content.sections[0] & { stats?: readonly { value: string; label: string }[] };
type SectionWithPresets = typeof content.sections[0] & { presets?: readonly { name: string; id: string; color: string; description: string }[] };
type SectionWithPersonas = typeof content.sections[0] & { personas?: readonly { name: string; tagline: string; color: string; vibe: string; keys: readonly string[] }[] };
---

<Layout
  title="Features — CIPHER-MUX"
  description={content.hero.subtext}
  lang={lang}
  active="features"
>
  <div class="features-page">

    <!-- Anchor Nav (right side, sticky) -->
    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">{t(lang, 'scroll.label')}</div>
      {content.scrollNavItems.map((item) => (
        <a href={`#${item.id}`} class="cm-anchor-nav-item">
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Hero -->
    <section class="features-hero">
      <span class="features-hero-kicker">{content.hero.kicker}</span>
      <h1>{content.hero.title}</h1>
      <p class="features-hero-sub">{content.hero.subtext}</p>
    </section>

    <!-- 11 Feature Sections -->
    {content.sections.map((section) => {
      const sectionId = sectionIdMap[section.num] ?? section.num;
      const s = section as SectionWithStats & SectionWithPresets & SectionWithPersonas;
      return (
        <section id={sectionId} class="feature-section">
          <header class="cm-section-header">
            <div class="cm-section-header-meta">
              <span class="cm-section-header-num">{section.num}</span>
              <span class="cm-section-header-line"></span>
              <span class="cm-section-header-kicker">{section.kicker}</span>
            </div>
            <h2>{section.title}</h2>
            <p class="cm-section-header-lead">{section.lead}</p>
          </header>

          {/* 01 Cockpit — Grid schematic + Stat boxes */}
          {section.num === '01' && (
            <div class="grid-schematic">
              <div class="grid-schematic-chrome">
                <span class="grid-schematic-dots">
                  <span style="background:#FF5F57"></span>
                  <span style="background:#FEBC2E"></span>
                  <span style="background:#28C840"></span>
                </span>
                <span class="grid-schematic-title">● cipher-mux</span>
              </div>
              <div class="grid-schematic-body">
                <div class="grid-schematic-cells">
                  <div class="grid-cell">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#ffb74d"></span><span>[0,0]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">companion</div>
                  </div>
                  <div class="grid-cell">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#ef5350"></span><span>[1,0]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">refinement</div>
                  </div>
                  <div class="grid-cell grid-cell--rowspan">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#ab47bc"></span><span>[2,0x2]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">cyber-factory</div>
                    <div class="grid-cell-detail">&#9656; Plan-Modus aktiv<br/>&#9656; Wave 2 / 5<br/>&#9656; 3 worker spawned</div>
                  </div>
                  <div class="grid-cell">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#c0392b"></span><span>[3,0]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">audit</div>
                  </div>
                  <div class="grid-cell">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#9b59b6"></span><span>[0,1]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">voice-companion</div>
                  </div>
                  <div class="grid-cell grid-cell--notes">
                    <div class="grid-cell-header"><span>[1,1]</span><span class="grid-cell-prompt">/notes</span></div>
                    <div class="grid-cell-role">notes &middot; handoff</div>
                    <div class="grid-cell-detail" style="font-style:italic"># session-handoff<br/>## Was zu kl&auml;ren ist...</div>
                  </div>
                  <div class="grid-cell">
                    <div class="grid-cell-header"><span class="grid-cell-dot" style="background:#ff7043"></span><span>[3,1]</span><span class="grid-cell-prompt">$_</span></div>
                    <div class="grid-cell-role">debugger</div>
                  </div>
                </div>
                <div class="grid-annotations">
                  <div>
                    <span class="cm-tag-inline">// row-span (vertikal!)</span>
                    <p>Sessions wachsen in der H&ouml;he f&uuml;r mehr Output. Niemals in der Breite &mdash; eine Session ist immer eine Spalte.</p>
                  </div>
                  <div>
                    <span class="cm-tag-inline">// notes-zelle</span>
                    <p>Statt Terminal: integrierter Markdown-Editor. Handoff-Notes, Specs, Memos &mdash; direkt im Grid.</p>
                  </div>
                  <div>
                    <span class="cm-tag-inline">// preset-marker</span>
                    <p>Farbcode = Preset (Funktion). Persona ist orthogonal und kann jederzeit gewechselt werden.</p>
                  </div>
                </div>
              </div>
              <div class="grid-statusbar">
                <span><span class="on">● OFF</span> STT COM</span>
                <span>features</span>
                <span>section 03 / 12</span>
                <span class="grid-statusbar-theme">cipher-dark</span>
                <span class="grid-statusbar-version">v0.9.9-dev</span>
              </div>
              <div class="grid-theme-bar">
                {[
                  { id: 'cipher-ivory',    bg: '#F2F2E8', elevated: '#FFFFF0', sunken: '#E8E8DE', border: '#3A3F47', text: '#1A1A1D', dim: '#6A6A72', accent: '#2d8a4e' },
                  { id: 'cipher-dark',     bg: '#2A2A32', elevated: '#33333C', sunken: '#222228', border: '#3E3E4A', text: '#D8D8E0', dim: '#6E6E80', accent: '#5C9A6E' },
                  { id: 'blueprint',       bg: '#0E2A44', elevated: '#143657', sunken: '#081C30', border: '#2E6FA0', text: '#DCEEFF', dim: '#6A8FB4', accent: '#7FD3FF' },
                  { id: 'warm-paper',      bg: '#F7F2E8', elevated: '#FFFBF0', sunken: '#EDE6D4', border: '#C4B89A', text: '#3A2E1A', dim: '#8A7A5E', accent: '#8B4513' },
                  { id: 'gruvbox-dark',    bg: '#282828', elevated: '#32302F', sunken: '#1D2021', border: '#504945', text: '#EBDBB2', dim: '#928374', accent: '#FABD2F' },
                  { id: 'nord',            bg: '#2E3440', elevated: '#3B4252', sunken: '#242933', border: '#434C5E', text: '#ECEFF4', dim: '#7B8394', accent: '#88C0D0' },
                  { id: 'synthwave',       bg: '#1A0B2E', elevated: '#241040', sunken: '#0E0520', border: '#4A1E6E', text: '#F8E6FF', dim: '#8A6BB0', accent: '#FF2EAA' },
                  { id: 'matrix',          bg: '#000000', elevated: '#030805', sunken: '#000000', border: '#0A5030', text: '#00FF41', dim: '#008820', accent: '#00FF41' },
                  { id: 'brutalist',       bg: '#FFFFFF', elevated: '#FFFFFF', sunken: '#F0F0F0', border: '#000000', text: '#000000', dim: '#707070', accent: '#FF3300' },
                  { id: 'high-contrast',   bg: '#000000', elevated: '#0A0A0A', sunken: '#000000', border: '#FFFFFF', text: '#FFFFFF', dim: '#B0B0B0', accent: '#FFFF00' },
                ].map((t) => (
                  <button
                    class="grid-theme-dot"
                    data-theme-id={t.id}
                    data-t-bg={t.bg} data-t-elevated={t.elevated} data-t-sunken={t.sunken}
                    data-t-border={t.border} data-t-text={t.text} data-t-dim={t.dim} data-t-accent={t.accent}
                    style={`background:${t.bg};border-color:${t.border}`}
                    title={t.id}
                  ><span style={`background:${t.accent}`}></span></button>
                ))}
              </div>
            </div>
          )}

          {s.stats && (
            <div class="stat-grid">
              {s.stats.map((stat) => (
                <div class="stat-box">
                  <span class="stat-value">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}

          {/* 02 Grid — Layout gallery */}
          {section.num === '02' && (
            <div class="layout-gallery">
              <span class="cm-tag-inline">// typische workspaces (mockups)</span>
              <div class="layout-gallery-row">
                <div class="layout-mini">
                  <div class="layout-mini-label"><span>Triage</span><span>3x2</span></div>
                  <div class="layout-mini-grid" style="grid-template-columns:repeat(3,1fr)">
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-companion)"></span>comp</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-audit)"></span>audit</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div>
                    <div class="layout-mini-cell layout-mini-cell--empty"></div>
                    <div class="layout-mini-cell layout-mini-cell--empty"></div>
                  </div>
                </div>
                <div class="layout-mini layout-mini--active">
                  <div class="layout-mini-label"><span>Dual + Plan</span><span>2x2</span></div>
                  <div class="layout-mini-grid" style="grid-template-columns:repeat(2,1fr)">
                    <div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-testing)"></span>test</div>
                  </div>
                </div>
                <div class="layout-mini">
                  <div class="layout-mini-label"><span>Solo Focus</span><span>1x2</span></div>
                  <div class="layout-mini-grid" style="grid-template-columns:1fr">
                    <div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div>
                  </div>
                </div>
                <div class="layout-mini">
                  <div class="layout-mini-label"><span>Maker</span><span>4x2</span></div>
                  <div class="layout-mini-grid" style="grid-template-columns:repeat(4,1fr)">
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-ideation)"></span>id</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div>
                    <div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-companion)"></span>comp</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-voice)"></span>voice</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-testing)"></span>test</div>
                    <div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-debugger)"></span>dbg</div>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* 03 Sessions — Two-column layout */}
          {section.num === '03' && (
            <div class="sessions-grid">
              <div class="sessions-anatomy">
                <span class="cm-tag-inline">// session anatomy</span>
                <ul class="accent-list">
                  <li>Eigener Claude-Code-Prozess pro Zelle</li>
                  <li>Eigener Kontext, eigene CLAUDE.md, eigene History</li>
                  <li>Header-Controls: Expand, Projekt wechseln, Shell, Close</li>
                  <li>Klick auf Header = Fokus, visuelle Hervorhebung</li>
                  <li><strong>$-Button:</strong> direkt ins tmux-Terminal der Session</li>
                  <li><strong>Eject:</strong> Session aus dem Grid in eigenes Fenster</li>
                </ul>
              </div>
              <div class="sessions-recovery">
                <span class="cm-tag-inline">// recovery</span>
                <div class="recovery-mock">
                  <div class="recovery-label">// nach app-restart</div>
                  <div class="recovery-line">● 3 sessions found in tmux</div>
                  <div class="recovery-sessions">
                    <div>&#10003; orchestrator <span class="dim">&middot; running 2h 14m</span></div>
                    <div>&#10003; companion <span class="dim">&middot; running 2h 14m</span></div>
                    <div>&#10003; cyber-factory <span class="dim">&middot; running 0h 47m</span></div>
                  </div>
                  <div class="recovery-actions">
                    <span class="recovery-btn recovery-btn--accent">RESUME</span>
                    <span class="recovery-btn">CLOSE ALL</span>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* 04 Presets — 8 cards */}
          {s.presets && (
            <div class="preset-grid">
              {s.presets.map((preset) => (
                <div class="preset-card" style={`--preset-color:${preset.color}`}>
                  <div class="preset-stripe"></div>
                  <div class="preset-header">
                    <span class="preset-dot" style={`background:${preset.color}`}></span>
                    <span class="preset-name">{preset.name}</span>
                  </div>
                  <div class="preset-id">&gt; {preset.id}</div>
                  <p class="preset-desc">{preset.description}</p>
                </div>
              ))}
            </div>
          )}

          {/* 05 Personas — compact cards with expand */}
          {s.personas && (
            <div class="persona-grid">
              {s.personas.map((persona) => (
                <details class="persona-card" style={`--persona-color:${persona.color}`}>
                  <summary class="persona-summary">
                    <div class="persona-stripe"></div>
                    <div class="persona-name">{persona.name}</div>
                    <div class="persona-tagline">// {persona.tagline}</div>
                    <div class="persona-vibe-short">{persona.vibe}</div>
                  </summary>
                  <div class="persona-detail">
                    <div class="persona-keys">
                      {persona.keys.map((k) => <span>{k}</span>)}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          )}

          {/* 06 Prompts — Resolution hierarchy */}
          {section.num === '06' && (
            <div class="prompt-resolution">
              <div class="prompt-resolution-box prompt-resolution-box--accent">
                <span class="cm-tag-inline">// persona-resolution beim session-start</span>
                <div class="prompt-resolution-stack">
                  <div class="prompt-resolution-step"><span class="prompt-step-num">1.</span><span><strong>Globale Aktiv-Persona</strong> <span class="dim">&mdash; wenn gesetzt: gilt f&uuml;r alle Sessions</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">2.</span><span><strong>Preset-Override</strong> <span class="dim">&mdash; Auswahl im Preset-Editor</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">3.</span><span><strong>Default-Matrix</strong> <span class="dim">&mdash; Empfehlung aus dem Pack</span></span></div>
                  <div class="prompt-resolution-step"><span class="dim">&darr;</span><span class="dim" style="font-style:italic">Hardcoded Fallback: Relay</span></div>
                </div>
              </div>
              <div class="prompt-layers-box">
                <span class="cm-tag-inline">// system-prompt &middot; 3 ebenen pro session</span>
                <div class="prompt-layers">
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-preset-cyberfactory)"></span><span class="prompt-layer-name">Preset</span><span>Rolle, Phasen, Tools, Grenzen</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-persona-cipher)"></span><span class="prompt-layer-name">Persona</span><span>Tonalit&auml;t, Stilistik (Hut)</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-accent)"></span><span class="prompt-layer-name">Workspace</span><span>Projekt-Pfade, Memory, Custom-Prompt-Teile</span></div>
                </div>
              </div>
            </div>
          )}

          {/* 07 Voice — 4-column boxes + TTS strip */}
          {section.num === '07' && (
            <div class="voice-grid">
              <div class="voice-box">
                <div class="voice-box-title">● whisper.cpp</div>
                <div class="voice-box-sub">lokal &middot; keine cloud</div>
                <ul class="accent-list"><li>VAD: erkennt pausen</li><li>review-then-submit</li><li>transkript zuerst sichtbar</li></ul>
              </div>
              <div class="voice-box">
                <div class="voice-box-title">● voice cmds</div>
                <div class="voice-box-sub">sprache &rarr; aktion</div>
                <ul class="accent-list"><li>&quot;abschicken&quot; / &quot;senden&quot;</li><li>&quot;hoch&quot; / &quot;runter&quot;</li><li>&quot;zum marker&quot;</li></ul>
              </div>
              <div class="voice-box">
                <div class="voice-box-title">● grid nav</div>
                <div class="voice-box-sub">fokus per stimme</div>
                <ul class="accent-list"><li>&quot;grid links/rechts&quot;</li><li>&quot;grid hoch/runter&quot;</li><li>fuzzy: &quot;grit&quot;, &quot;zelle&quot;</li></ul>
              </div>
              <div class="voice-box">
                <div class="voice-box-title">● BT shutter</div>
                <div class="voice-box-sub">physischer submit</div>
                <ul class="accent-list"><li>STT-Pin auf session</li><li>BT-klick &rarr; send</li><li>komplett h&auml;ndefrei</li></ul>
              </div>
            </div>
          )}
          {section.num === '07' && (
            <div class="tts-strip">
              <div class="tts-strip-title">TTS</div>
              <div class="tts-strip-body">Jede Entity-Session kann Text vorlesen lassen. Piper im Voice-Modus, macOS <code>say</code> als Fallback.</div>
              <div class="tts-strip-modes"><span>NORMAL</span><span class="tts-mode--active">INTERRUPT</span></div>
            </div>
          )}

          {/* 08 Notes — Two-column */}
          {section.num === '08' && (
            <div class="notes-grid">
              <div class="notes-editor-box">
                <span class="cm-tag-inline">// notes editor</span>
                <div class="notes-editor-title">CodeMirror 6 &middot; Markdown live</div>
                <ul class="accent-list">
                  <li>YAML-Frontmatter (Titel, Tags)</li>
                  <li>Auto-Save nach 2s &middot; Cmd+S triggert Auto-Tagging</li>
                  <li>Ollama gemma3:4b (lokal) f&uuml;r Tag-Vorschl&auml;ge</li>
                  <li>Global oder Workspace-scoped</li>
                  <li>Tag-Tree in der Sidebar (NotesTreeView)</li>
                  <li>TestcaseView mit Checkboxen + Screenshots</li>
                  <li>Voller MCP-Zugriff: lesen, schreiben, suchen, handoff</li>
                </ul>
              </div>
              <div class="notes-memory-box">
                <span class="cm-tag-inline">// companion memory</span>
                <div class="notes-editor-title">SQLite &middot; FTS5 &middot; persistent</div>
                <p class="notes-memory-desc">Companion, Refinement, Voice-Relay merken sich Fakten, Pr&auml;ferenzen, Interaktionen, Ereignisse &mdash; &uuml;ber Sessions hinweg.</p>
                <div class="memory-categories">
                  <span>● Fakten</span><span>● Pr&auml;ferenzen</span><span>● Interaktionen</span><span>● Ereignisse</span>
                </div>
                <div class="memory-footer">Salienz-Bewertung 0&ndash;1 &middot; transparent &middot; vom User l&ouml;schbar<br/>MCP-Tools: <code>write &middot; recall &middot; search &middot; forget</code></div>
              </div>
            </div>
          )}

          {/* 09 MCP — Category grid */}
          {section.num === '09' && (
            <div class="mcp-grid">
              {[
                { name: 'Session Mgmt', count: '06', ex: 'create \u00b7 kill \u00b7 focus \u00b7 eject' },
                { name: 'Message Bus', count: '02', ex: 'send \u00b7 read' },
                { name: 'Context Monitor', count: '01', ex: 'context_status' },
                { name: 'Task Queue', count: '04', ex: 'create \u00b7 update \u00b7 list \u00b7 get' },
                { name: 'Bug Reports', count: '01', ex: 'resolve' },
                { name: 'Input Requests', count: '01', ex: 'create' },
                { name: 'Notes', count: '08', ex: 'CRUD \u00b7 search \u00b7 handoff_*' },
                { name: 'Companion Memory', count: '04', ex: 'write \u00b7 recall \u00b7 search \u00b7 forget' },
                { name: 'App Control', count: '10', ex: 'grid \u00b7 sidebar \u00b7 theme \u00b7 choreography' },
              ].map((c) => (
                <div class="mcp-card">
                  <div class="mcp-card-header">
                    <span class="mcp-card-name">{c.name}</span>
                    <span class="mcp-card-count">{c.count}</span>
                  </div>
                  <div class="mcp-card-ex">{c.ex}</div>
                </div>
              ))}
            </div>
          )}
          {section.num === '09' && (
            <div class="mcp-footer-strip">
              <span><span class="on">&#9656;</span> Bearer-Token wird pro Entity automatisch injiziert</span>
              <span><span class="on">&#9656;</span> Streamable HTTP &mdash; Standard MCP-Spec</span>
              <span>github.com/.../mcp &#8599;</span>
            </div>
          )}

          {/* 10 Themes — Swatches */}
          {section.num === '10' && (
            <div class="themes-grid">
              {[
                { name: 'cipher-ivory', bg: '#F4F3ED', fg: '#1A1A1D', tag: 'Light Default' },
                { name: 'cipher-dark', bg: '#1F1F23', fg: '#E8E6DD', tag: 'Dark Default' },
                { name: 'blueprint', bg: '#0E2B47', fg: '#7FB3FF', tag: '' },
                { name: 'warm-paper', bg: '#F1E9D2', fg: '#3A2E1F', tag: '' },
                { name: 'gruvbox-dark', bg: '#282828', fg: '#FBF1C7', tag: '' },
                { name: 'nord', bg: '#2E3440', fg: '#88C0D0', tag: 'Nord' },
                { name: 'synthwave', bg: '#1A0E2E', fg: '#FF6EC7', tag: '' },
                { name: 'matrix', bg: '#000000', fg: '#33FF66', tag: '' },
                { name: 'brutalist', bg: '#FFFFFF', fg: '#000000', tag: '' },
                { name: 'high-contrast', bg: '#000000', fg: '#FFFFFF', tag: 'WCAG AAA' },
              ].map((theme) => (
                <div class="theme-swatch">
                  <div class="theme-swatch-top" style={`background:${theme.bg};color:${theme.fg}`}>{theme.name}</div>
                  <div class="theme-swatch-bar" style={`background:${theme.fg}`}></div>
                  {theme.tag && <div class="theme-swatch-tag">{theme.tag}</div>}
                </div>
              ))}
            </div>
          )}

          {/* 11 Efficiency — 6 feature boxes */}
          {section.num === '11' && (
            <div class="efficiency-grid">
              {[
                { k: 'StatusLine Monitor', d: 'Echtzeit-Kontextverbrauch pro Zelle. Gr\u00fcn \u2192 orange (80%) \u2192 rot (90%).' },
                { k: 'Orchestrator-Watch', d: 'Pr\u00fcft Workers alle 2 Minuten. Bei 90%: finish, summarize, frischer Worker.' },
                { k: 'Message Bus', d: 'Async Messaging zwischen Sessions. Wenige Dutzend Tokens statt Tausende f\u00fcr shared Conversation.' },
                { k: 'Multi-Model-Routing', d: 'Orchestrator (Opus), Workers (Sonnet), einfache Tasks (Haiku). Richtiges Modell f\u00fcr richtige Aufgabe.' },
                { k: 'Handover-Pattern', d: 'Zusammenfassung \u2192 neue Session \u2192 weitermachen. Kein Qualit\u00e4tsverlust durch volle Kontexte.' },
                { k: 'Doom-Loop-Prevention', d: 'Nach 2 gescheiterten Fixes: neue Session. Confirmation-Trap-Vermeidung in CLAUDE.md.' },
              ].map((item, i) => (
                <div class="efficiency-item">
                  <span class="efficiency-num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <div class="efficiency-title">{item.k}</div>
                    <div class="efficiency-desc">{item.d}</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      );
    })}

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.feature-section');
      const navItems = document.querySelectorAll('.cm-anchor-nav-item');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navItems.forEach(item => item.classList.remove('active'));
            const activeItem = document.querySelector(`.cm-anchor-nav-item[href="#${entry.target.id}"]`);
            if (activeItem) activeItem.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      sections.forEach(s => observer.observe(s));

      // Theme Easter Egg — click dots to re-skin the grid mockup
      const schematic = document.querySelector('.grid-schematic') as HTMLElement | null;
      const themeLabel = document.querySelector('.grid-statusbar-theme') as HTMLElement | null;
      document.querySelectorAll('.grid-theme-dot').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!schematic) return;
          const d = (btn as HTMLElement).dataset;
          schematic.style.setProperty('--gs-bg', d.tBg!);
          schematic.style.setProperty('--gs-elevated', d.tElevated!);
          schematic.style.setProperty('--gs-sunken', d.tSunken!);
          schematic.style.setProperty('--gs-border', d.tBorder!);
          schematic.style.setProperty('--gs-text', d.tText!);
          schematic.style.setProperty('--gs-dim', d.tDim!);
          schematic.style.setProperty('--gs-accent', d.tAccent!);
          schematic.classList.add('grid-schematic--themed');
          if (themeLabel) themeLabel.textContent = d.themeId!;
          document.querySelectorAll('.grid-theme-dot').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });
  </script>
</Layout>

