---
import Layout from '../../layouts/Layout.astro';
import HeroCockpit from '../../components/HeroCockpit.astro';
import content from '../../i18n/de/landing';

const lang = 'de';

// pillar anchors removed — pillars no longer link to specific features sections

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "CIPHER-MUX",
    "url": "https://cipher-mux.dev"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CIPHER-MUX",
    "operatingSystem": "macOS",
    "applicationCategory": "DeveloperApplication",
    "license": "https://opensource.org/licenses/MIT",
    "url": "https://github.com/cmarkus42-rgb/cipher-mux-electron"
  }
]);
---

<Layout
  title="CIPHER-MUX"
  description={content.hero.subtext}
  lang={lang}
  active="landing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  <!-- Hero: Schematic Cockpit Mock -->
  <HeroCockpit
    label={content.hero.label}
    tagline={content.hero.tagline}
    taglineSub={content.hero.taglineSub}
    taglineEnd={content.hero.taglineEnd}
    subtext={content.hero.subtext}
    buttons={content.hero.buttons}
    lang={lang}
  />

  <!-- Pillars: Story-Stack -->
  <section class="v2-pillars">
    <div class="v2-pillars__inner">
      <div class="cm-kicker">
        <span class="cm-kicker__num">// 01</span>
        <span class="cm-kicker__line"></span>
        <span class="cm-kicker__text">VIER PFEILER &middot; EIN MANIFEST</span>
      </div>

      {content.pillars.map((pillar, i) => {
        const colors = ['#5E81AC', '#EBCB8B', '#A3BE8C', '#88C0D0'];
        const color = colors[i];
        const num = String(i + 1).padStart(2, '0');
        const isLast = i === content.pillars.length - 1;
        return (
          <div class="v2-pillar-row" style={`${isLast ? '' : 'border-bottom: 1px solid var(--color-border);'}`}>
            <div class="v2-pillar-num">
              <span class="v2-pillar-num__big" style={`color: ${color};`}>{num}</span>
              <span class="v2-pillar-num__label">// pfeiler</span>
            </div>
            <div class="v2-pillar-main">
              <h3 class="v2-pillar-title">{pillar.title}</h3>
              <p class="v2-pillar-desc">{pillar.description}</p>
            </div>
            <div class="v2-pillar-detail" style={`border-left-color: ${color};`}>
              <p>{pillar.detail}</p>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Built with Itself -->
  <section class="v2-built">
    <div class="v2-built__inner">
      <div class="cm-kicker">
        <span class="cm-kicker__num">// 02</span>
        <span class="cm-kicker__line"></span>
        <span class="cm-kicker__text">Selbstreferenz</span>
      </div>

      <h2 class="v2-built__title">Built with Itself<span class="accent-dot">.</span></h2>
      <p class="v2-built__lead">{content.builtWithItself.lead}</p>

      <div class="v2-built__stats">
        {content.builtWithItself.stats.map((stat) => (
          <div class="v2-stat-box">
            <span class="v2-stat-box__value">{stat.value}</span>
            <span class="v2-stat-box__label">{stat.label}</span>
          </div>
        ))}
      </div>

      <div class="v2-wave-chart">
        <div class="v2-wave-chart__header">// wachstum der test-suite &uuml;ber 8 wellen</div>
        {content.builtWithItself.waves.map((wave, i) => {
          const max = Math.max(...content.builtWithItself.waves.map(w => w.tests));
          const pct = Math.round((wave.tests / max) * 100);
          const isActive = i >= 4;
          return (
            <div class:list={['v2-wave-row', { 'v2-wave-row--active': isActive }]} style={i > 0 ? 'border-top: 1px dotted var(--color-border);' : ''}>
              <span class="v2-wave-row__label">{wave.label}</span>
              <div class="v2-wave-row__track">
                <div class:list={['v2-wave-row__bar', { 'v2-wave-row__bar--active': isActive }]} style={`width: ${pct}%;`}>
                  <span class="v2-wave-row__count">{wave.tests}</span>
                </div>
              </div>
              <span class="v2-wave-row__note">{wave.note}</span>
            </div>
          );
        })}
      </div>

      <div class="v2-built__closing">
        <p>{content.builtWithItself.detail}</p>
        <p class="v2-built__closer"><strong>{content.builtWithItself.closer}</strong></p>
      </div>
    </div>
  </section>

  <!-- Systemabgrenzung -->
  <section class="v2-not">
    <div class="v2-not__inner">
      <div class="cm-kicker">
        <span class="cm-kicker__num">// 03</span>
        <span class="cm-kicker__line"></span>
        <span class="cm-kicker__text">Systemabgrenzung</span>
      </div>

      <h2 class="v2-not__title">Was CIPHER-MUX <em>nicht</em> ist.</h2>
      <p class="v2-not__lead">{content.notSection.lead}</p>

      <div class="v2-not__list">
        {content.notSection.items.map((item, i) => {
          const num = String(i + 1).padStart(2, '0');
          return (
            <div class="v2-not__item" style={i < content.notSection.items.length - 1 ? 'border-bottom: 1px dotted var(--color-border);' : ''}>
              <span class="v2-not__num">{num}</span>
              <span class="v2-not__text">{item}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="v2-bottom-cta">
    <div class="v2-bottom-cta__inner">
      <span class="v2-bottom-cta__kicker">// Bereit?</span>
      <h2 class="v2-bottom-cta__title">Lies das Handbuch<span class="accent-dot">.</span> <span class="dim">Oder lad's runter.</span></h2>
      <div class="v2-bottom-cta__buttons">
        <a href="/de/docs/" class="cm-btn cm-btn--primary">Dokumentation</a>
        <a href="/de/features" class="cm-btn">Features</a>
        <a href="https://github.com/cmarkus42/cipher-mux-electron" class="cm-btn" target="_blank" rel="noopener noreferrer">GitHub &#x2197;</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================================
     PILLARS: Story-Stack (3-col rows)
     ============================================================ */
  .v2-pillars {
    padding: 72px 32px 48px;
    max-width: 1060px;
    margin: 0 auto;
  }
  .v2-pillars__inner { max-width: 100%; }

  .v2-pillar-row {
    display: grid;
    grid-template-columns: 120px 1fr 1fr;
    gap: 28px;
    padding: 24px 0;
  }

  .v2-pillar-num {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .v2-pillar-num__big {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 64px;
    line-height: 0.9;
    letter-spacing: -2px;
  }
  .v2-pillar-num__label {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 1.5px;
  }

  .v2-pillar-main {}
  .v2-pillar-title {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 24px;
    margin: 0 0 10px;
    color: var(--color-text);
  }
  .v2-pillar-desc {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 500;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .v2-pillar-detail {
    border-left: 2px solid var(--color-border);
    padding-left: 16px;
  }
  .v2-pillar-detail p {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 720px) {
    .v2-pillars { padding: 48px 20px 36px; }
    .v2-pillar-row {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px 0;
    }
    .v2-pillar-num {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
    .v2-pillar-num__big { font-size: 40px; }
    .v2-pillar-detail {
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 12px;
    }
  }

  /* ============================================================
     BUILT WITH ITSELF
     ============================================================ */
  .v2-built {
    background: var(--color-bg-sunken);
    padding: 72px 32px 64px;
  }
  .v2-built__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .v2-built__title {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 44px;
    margin: 16px 0 12px;
    color: var(--color-text);
    line-height: 1.1;
  }
  .accent-dot { color: var(--color-accent); }
  .dim { color: var(--color-text-dim); }

  .v2-built__lead {
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 720px;
    margin: 0 0 36px;
  }

  .v2-built__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }
  .v2-stat-box {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .v2-stat-box__value {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: var(--color-accent);
  }
  .v2-stat-box__label {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text);
  }

  /* Wave Chart */
  .v2-wave-chart {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    padding: 20px 24px;
    margin-bottom: 36px;
  }
  .v2-wave-chart__header {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 16px;
  }
  .v2-wave-row {
    display: grid;
    grid-template-columns: 90px 1fr 90px;
    gap: 12px;
    align-items: center;
    padding: 8px 0;
    font-family: 'Fira Code', monospace;
    font-size: 11px;
  }
  .v2-wave-row__label {
    color: var(--color-text-dim);
    white-space: nowrap;
    font-size: 11px;
  }
  .v2-wave-row--active .v2-wave-row__label {
    color: var(--color-text);
  }
  .v2-wave-row__track {
    position: relative;
    height: 22px;
    background: var(--color-bg-sunken);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  .v2-wave-row__bar {
    height: 100%;
    background: var(--color-text-dim);
    opacity: 0.4;
    display: flex;
    align-items: center;
    padding-left: 8px;
    min-width: 40px;
    border-radius: 2px 0 0 2px;
  }
  .v2-wave-row__bar--active {
    background: var(--color-accent);
    opacity: 1;
  }
  .v2-wave-row__count {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    color: var(--color-bg);
    font-weight: 600;
  }
  .v2-wave-row__bar:not(.v2-wave-row__bar--active) .v2-wave-row__count {
    color: var(--color-text-dim);
  }
  .v2-wave-row__note {
    color: var(--color-text-dim);
    font-size: 10px;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v2-wave-row--active .v2-wave-row__note {
    color: var(--color-text-secondary);
  }

  .v2-built__closing {
    max-width: 720px;
  }
  .v2-built__closing p {
    font-family: 'Rajdhani', sans-serif;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 12px;
  }
  .v2-built__closer strong {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .v2-built { padding: 48px 20px 40px; }
    .v2-built__title { font-size: 32px; }
    .v2-built__stats { grid-template-columns: repeat(2, 1fr); }
    .v2-wave-row { grid-template-columns: 70px 1fr; gap: 8px; }
    .v2-wave-row__note { display: none; }
    .v2-stat-box__value { font-size: 32px; }
  }

  /* ============================================================
     SYSTEMABGRENZUNG
     ============================================================ */
  .v2-not {
    padding: 72px 32px 64px;
    max-width: 860px;
    margin: 0 auto;
  }
  .v2-not__inner { max-width: 100%; }

  .v2-not__title {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 36px;
    margin: 16px 0 8px;
    color: var(--color-text);
    line-height: 1.15;
  }
  .v2-not__title em {
    color: var(--color-text-dim);
    font-style: italic;
  }
  .v2-not__lead {
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0 0 28px;
  }
  .v2-not__list {
    display: flex;
    flex-direction: column;
  }
  .v2-not__item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
  }
  .v2-not__num {
    flex: 0 0 28px;
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-accent);
    letter-spacing: 1px;
  }
  .v2-not__text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .v2-not { padding: 48px 20px 40px; }
    .v2-not__title { font-size: 28px; }
  }

  /* ============================================================
     BOTTOM CTA
     ============================================================ */
  .v2-bottom-cta {
    background: var(--color-bg-sunken);
    border-top: 1px solid var(--color-border);
    padding: 64px 56px 80px;
    text-align: center;
  }
  .v2-bottom-cta__inner {
    max-width: 700px;
    margin: 0 auto;
  }
  .v2-bottom-cta__kicker {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 16px;
  }
  .v2-bottom-cta__title {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 36px;
    margin: 0 0 28px;
    color: var(--color-text);
    line-height: 1.15;
  }
  .v2-bottom-cta__buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 720px) {
    .v2-bottom-cta { padding: 48px 24px 56px; }
    .v2-bottom-cta__title { font-size: 28px; }
    .v2-bottom-cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
