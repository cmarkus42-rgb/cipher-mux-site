---
import Layout from '../../layouts/Layout.astro';
import HeroCockpit from '../../components/HeroCockpit.astro';
import content from '../../i18n/de/landing';

const lang = 'de';

// pillar anchors removed — pillars no longer link to specific features sections

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "CIPHER-MUX",
    "url": "https://cipher-mux.dev"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CIPHER-MUX",
    "operatingSystem": "macOS",
    "applicationCategory": "DeveloperApplication",
    "license": "https://opensource.org/licenses/MIT",
    "url": "https://github.com/cmarkus42/cipher-mux-electron"
  }
]);
---

<Layout
  title="CIPHER-MUX"
  description={content.hero.subtext}
  lang={lang}
  active="landing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={schema} />
  </Fragment>

  <!-- Hero: Schematic Cockpit Mock -->
  <HeroCockpit
    label={content.hero.label}
    tagline={content.hero.tagline}
    taglineSub={content.hero.taglineSub}
    taglineEnd={content.hero.taglineEnd}
    subtext={content.hero.subtext}
    buttons={content.hero.buttons}
    lang={lang}
  />

  <!-- Pillars -->
  <section class="cm-pillars">
    {content.pillars.map((pillar, i) => {
      const accents = ['#ab47bc', '#ffb74d', '#5C9A6E', '#88C0D0'];
      return (
        <div class="cm-pillar" style={`--pillar-accent: ${accents[i]}`}>
          <div class="cm-pillar-stripe"></div>
          <div class="cm-pillar-marker">
            <span class="cm-pillar-marker__num">0{i + 1}</span>
          </div>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
        </div>
      );
    })}
  </section>

  <!-- Not-Section -->
  <section class="cm-not">
    <h3>{content.notSection.title}</h3>
    {content.notSection.lead && <p class="cm-lead" style="margin-bottom: 22px;">{content.notSection.lead}</p>}
    <ul>
      {content.notSection.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <!-- Bottom CTA -->
  <div class="cm-cta-row">
    <a href="/de/start" class="cm-btn cm-btn--primary">Download</a>
    <a href="/de/features" class="cm-btn">Features</a>
    <a href="https://github.com/cmarkus42/cipher-mux-electron" class="cm-btn" target="_blank" rel="noopener noreferrer">GitHub</a>
  </div>
</Layout>

<style>
  .cm-cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    padding: 48px 32px 72px;
  }

  @media (max-width: 768px) {
    .cm-cta-row {
      flex-direction: column;
      align-items: center;
      padding: 36px 20px 56px;
    }
  }
</style>
