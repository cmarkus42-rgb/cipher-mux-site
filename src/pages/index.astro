---
import Layout from '../layouts/Layout.astro';
import PixelGrid from '../components/PixelGrid.astro';
import PillarCard from '../components/PillarCard.astro';
---

<Layout
  title="CIPHER-MUX — Dein Coding-Cockpit"
  description="CIPHER-MUX macht KI-gestuetztes Bauen zugaenglich, transparent und lehrbar. Fuer alle die Ideen haben — und endlich selbst anfangen wollen."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "CIPHER-MUX",
        "url": "https://cmarkus42.github.io/cipher-mux-site"
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "CIPHER-MUX",
        "operatingSystem": "macOS",
        "applicationCategory": "DeveloperApplication",
        "license": "https://opensource.org/licenses/MIT",
        "url": "https://github.com/cmarkus42/cipher-mux-electron"
      }
    ])} />
  </Fragment>

  <!-- Hero -->
  <section class="hero grid-bg">
    <div class="hero-inner">
      <PixelGrid cellSize={14} gap={3} />
      <span class="label-tag">Open Source &middot; macOS &middot; MIT</span>
      <h1>Dein Coding-Cockpit.</h1>
      <p class="hero-subtitle">
        CIPHER-MUX macht KI-gestuetztes Bauen zugaenglich, transparent und lehrbar.
        Fuer alle die Ideen haben — und endlich selbst anfangen wollen.
      </p>
      <div class="hero-ctas">
        <a href="/cipher-mux-site/start" class="btn btn--primary">Loslegen</a>
        <a href="/cipher-mux-site/features" class="btn">Features</a>
        <a href="https://github.com/cmarkus42/cipher-mux-electron" class="btn" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="pillars-section">
    <div class="pillars-grid">
      <div class="pillar-cell pillar-cell--border-right pillar-cell--border-bottom">
        <PillarCard
          title="Beschreiben statt coden"
          description="Du sagst was du willst. Nicht wie. Spezialisierte KI-Agenten setzen um — parallel, sichtbar, steuerbar."
          link="/cipher-mux-site/features#bauen"
          iconPattern="diagonal"
        />
      </div>
      <div class="pillar-cell pillar-cell--border-bottom">
        <PillarCard
          title="Von der Idee zum Projekt"
          description="Fuenf Phasen, fuenf Denkweisen — ein Cockpit das dich durch den gesamten Prozess fuehrt. Nicht Prompt rein, Code raus."
          link="/cipher-mux-site/features#prozess"
          iconPattern="flow"
        />
      </div>
      <div class="pillar-cell pillar-cell--border-right">
        <PillarCard
          title="Lernen durch Machen"
          description="Alles liegt offen. Jeder Prompt sichtbar, jede Entscheidung nachvollziehbar, jedes Konzept erklaerbar."
          link="/cipher-mux-site/features#transparent"
          iconPattern="eye"
        />
      </div>
      <div class="pillar-cell">
        <PillarCard
          title="Fuer alle"
          description="Voice Input, High-Contrast, eingebauter Lehr-Assistent. Die Huerde ist so niedrig wie wir sie kriegen koennen."
          link="/cipher-mux-site/features#zugaenglich"
          iconPattern="inclusive"
        />
      </div>
    </div>
  </section>

  <!-- Was es nicht ist -->
  <section class="not-section section">
    <div class="not-inner">
      <h3 class="not-heading">Was CIPHER-MUX nicht ist</h3>
      <ul class="not-list">
        <li>Kein fertiges Produkt eines Startups. Ein Seitenprojekt, 100% KI-generiert, aus Begeisterung entstanden.</li>
        <li>Kein Ersatz fuer Claude Code. Ein Cockpit das draufsitzt und es steuerbar macht.</li>
        <li>Kein &ldquo;klick und fertig&rdquo;. Du musst beschreiben koennen was du willst — praezise, ehrlich, klar.</li>
        <li>macOS only. Vorerst.</li>
        <li>Kein Support-SLA. Ein Mensch, ein Projekt, ehrliches Teilen.</li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTAs -->
  <section class="bottom-ctas section">
    <div class="bottom-ctas-inner">
      <a href="/cipher-mux-site/start" class="btn btn--primary">Loslegen</a>
      <a href="/cipher-mux-site/features#prozess" class="btn">Den Prozess verstehen</a>
      <a href="https://github.com/cmarkus42/cipher-mux-electron" class="btn" target="_blank" rel="noopener">Auf GitHub ansehen</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 48px; /* fixed header offset */
  }

  .hero-inner {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: var(--space-4xl) var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  .hero-subtitle {
    max-width: 560px;
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  /* Pillars */
  .pillars-section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-2xl);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .pillar-cell--border-right {
    border-right: 1px solid var(--color-border);
  }

  .pillar-cell--border-bottom {
    border-bottom: 1px solid var(--color-border);
  }

  /* Not-section */
  .not-section {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .not-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .not-heading {
    font-family: 'Rajdhani', Impact, 'Arial Narrow', sans-serif;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: var(--space-xl);
  }

  .not-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .not-list li {
    border-left: 2px solid var(--color-border);
    padding-left: 16px;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Bottom CTAs */
  .bottom-ctas-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .pillar-cell--border-right {
      border-right: none;
    }
    .pillar-cell--border-bottom {
      border-bottom: 1px solid var(--color-border);
    }
    /* Add bottom border to all cells on mobile except last */
    .pillar-cell:not(:last-child) {
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
