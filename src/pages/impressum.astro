---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum — CIPHER-MUX"
  description="Impressum gemaess TMG §5"
>
  <div class="legal-page">
    <div class="legal-inner">
      <h1>Impressum</h1>
      <p class="legal-intro">Angaben gemaess § 5 TMG</p>

      <!-- PLATZHALTER: Hier den generierten Impressum-Text einfuegen -->
      <!-- Generator: https://www.e-recht24.de/impressum-generator.html -->

      <div class="legal-placeholder">
        <p>Impressum-Text wird noch eingefuegt.</p>
        <p>Bitte generiere deinen Impressum-Text unter:<br>
        <a href="https://www.e-recht24.de/impressum-generator.html">e-recht24.de/impressum-generator</a></p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding-top: 48px;
    min-height: 60vh;
  }

  .legal-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4xl) var(--space-2xl) var(--space-3xl);
  }

  h1 {
    font-family: 'Rajdhani', Impact, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
  }

  h2 {
    font-family: 'Rajdhani', Impact, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
  }

  .legal-intro {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 1px;
    margin-bottom: var(--space-3xl);
  }

  p {
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    line-height: 1.85;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  ul li {
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    padding-left: var(--space-xl);
    position: relative;
  }

  ul li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-family: 'Fira Code', monospace;
    font-size: 12px;
  }

  .legal-placeholder {
    border: 2px dashed var(--color-border);
    padding: 24px;
    color: var(--color-text-dim);
    background: var(--color-bg-sunken);
    margin-top: var(--space-2xl);
  }

  .legal-placeholder p {
    color: var(--color-text-dim);
    margin-bottom: var(--space-sm);
  }

  .legal-placeholder p:last-child {
    margin-bottom: 0;
  }

  .legal-placeholder a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .legal-placeholder a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .legal-inner {
      padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
    }
  }
</style>
