---
import Layout from '../../layouts/Layout.astro';
import content from '../../i18n/en/features';
import { t } from '../../i18n/ui';

const lang = 'en';

const sectionIdMap: Record<string, string> = {
  '01': 'cockpit',
  '02': 'grid',
  '03': 'sessions',
  '04': 'personas',
  '05': 'presets',
  '06': 'prompts',
  '07': 'voice',
  '08': 'notes',
  '09': 'mcp',
  '10': 'themes',
  '11': 'efficiency',
};

type SectionWithStats = typeof content.sections[0] & { stats?: readonly { value: string; label: string }[] };
type SectionWithRoles = typeof content.sections[0] & { roles?: readonly { name: string; description: string }[] };
---

<Layout
  title="Features — CIPHER-MUX"
  description={content.hero.subtext}
  lang={lang}
  active="features"
>
  <div class="features-page">

    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">{t(lang, 'scroll.label')}</div>
      {content.scrollNavItems.map((item) => (
        <a href={`#${item.id}`} class="cm-anchor-nav-item">
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <section class="features-hero">
      <span class="features-hero-kicker">{content.hero.kicker}</span>
      <h1>{content.hero.title}</h1>
      <p class="features-hero-sub">{content.hero.subtext}</p>
    </section>

    {content.sections.map((section) => {
      const sectionId = sectionIdMap[section.num] ?? section.num;
      const s = section as SectionWithStats & SectionWithRoles;
      return (
        <section id={sectionId} class="feature-section">
          <header class="cm-section-header">
            <div class="cm-section-header-meta">
              <span class="cm-section-header-num">{section.num}</span>
              <span class="cm-section-header-line"></span>
              <span class="cm-section-header-kicker">{section.kicker}</span>
            </div>
            <h2>{section.title}</h2>
            <p class="cm-section-header-lead">{section.lead}</p>
          </header>

          {s.stats && (
            <div class="stat-grid">
              {s.stats.map((stat) => (
                <div class="stat-box">
                  <span class="stat-value">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}

          {section.num === '02' && (
            <div class="grid-schematic">
              <div class="grid-schematic-chrome">
                <span class="grid-schematic-dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></span>
                <span class="grid-schematic-title">● cipher-mux</span>
              </div>
              <div class="grid-schematic-body">
                <div class="grid-schematic-cells">
                  <div class="grid-cell"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-companion)"></span><span>[0,0]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">companion</div></div>
                  <div class="grid-cell"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span><span>[1,0]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">refinement</div></div>
                  <div class="grid-cell grid-cell--rowspan"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span><span>[2,0x2]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">cyber-factory</div><div class="grid-cell-detail">&#9656; Plan mode active<br/>&#9656; Wave 2 / 5<br/>&#9656; 3 workers spawned</div></div>
                  <div class="grid-cell"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-audit)"></span><span>[3,0]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">audit</div></div>
                  <div class="grid-cell"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-voice)"></span><span>[0,1]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">voice-companion</div></div>
                  <div class="grid-cell grid-cell--notes"><div class="grid-cell-header"><span>[1,1]</span><span class="grid-cell-prompt">/notes</span></div><div class="grid-cell-role">notes &middot; handoff</div><div class="grid-cell-detail" style="font-style:italic"># session-handoff<br/>## Open questions...</div></div>
                  <div class="grid-cell"><div class="grid-cell-header"><span class="grid-cell-dot" style="background:var(--color-preset-debugger)"></span><span>[3,1]</span><span class="grid-cell-prompt">$_</span></div><div class="grid-cell-role">debugger</div></div>
                </div>
                <div class="grid-annotations">
                  <div><span class="cm-tag-inline">// row-span (vertical!)</span><p>Sessions grow in height for more output. Never in width &mdash; one session is always one column.</p></div>
                  <div><span class="cm-tag-inline">// notes cell</span><p>Instead of a terminal: integrated Markdown editor. Handoff notes, specs, memos &mdash; right in the grid.</p></div>
                  <div><span class="cm-tag-inline">// preset marker</span><p>Color code = preset (function). Persona is orthogonal and can be switched at any time.</p></div>
                </div>
              </div>
              <div class="grid-statusbar"><span><span class="on">● OFF</span> STT COM</span><span>features</span><span>section 03 / 12</span><span>nord</span><span class="grid-statusbar-version">v0.9.9-dev</span></div>
            </div>
          )}

          {section.num === '02' && (
            <div class="layout-gallery">
              <span class="cm-tag-inline">// typical workspaces (mockups)</span>
              <div class="layout-gallery-row">
                <div class="layout-mini"><div class="layout-mini-label"><span>Triage</span><span>3x2</span></div><div class="layout-mini-grid" style="grid-template-columns:repeat(3,1fr)"><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-companion)"></span>comp</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-audit)"></span>audit</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div><div class="layout-mini-cell layout-mini-cell--empty"></div><div class="layout-mini-cell layout-mini-cell--empty"></div></div></div>
                <div class="layout-mini layout-mini--active"><div class="layout-mini-label"><span>Dual + Plan</span><span>2x2</span></div><div class="layout-mini-grid" style="grid-template-columns:repeat(2,1fr)"><div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-testing)"></span>test</div></div></div>
                <div class="layout-mini"><div class="layout-mini-label"><span>Solo Focus</span><span>1x2</span></div><div class="layout-mini-grid" style="grid-template-columns:1fr"><div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div></div></div>
                <div class="layout-mini"><div class="layout-mini-label"><span>Maker</span><span>4x2</span></div><div class="layout-mini-grid" style="grid-template-columns:repeat(4,1fr)"><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-ideation)"></span>id</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-refinement)"></span>ref</div><div class="layout-mini-cell" style="grid-row:span 2"><span class="grid-cell-dot" style="background:var(--color-preset-cyberfactory)"></span>cf</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-companion)"></span>comp</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-voice)"></span>voice</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-testing)"></span>test</div><div class="layout-mini-cell"><span class="grid-cell-dot" style="background:var(--color-preset-debugger)"></span>dbg</div></div></div>
              </div>
            </div>
          )}

          {section.num === '03' && (
            <div class="sessions-grid">
              <div class="sessions-anatomy">
                <span class="cm-tag-inline">// session anatomy</span>
                <ul class="accent-list"><li>Dedicated Claude Code process per cell</li><li>Own context, own CLAUDE.md, own history</li><li>Header controls: Expand, switch project, Shell, Close</li><li>Click header = focus, visual highlight</li><li><strong>$-Button:</strong> direct access to the session's tmux terminal</li><li><strong>Eject:</strong> detach session from the grid into its own window</li></ul>
              </div>
              <div class="sessions-recovery">
                <span class="cm-tag-inline">// recovery</span>
                <div class="recovery-mock">
                  <div class="recovery-label">// after app restart</div>
                  <div class="recovery-line">● 3 sessions found in tmux</div>
                  <div class="recovery-sessions"><div>&#10003; orchestrator <span class="dim">&middot; running 2h 14m</span></div><div>&#10003; companion <span class="dim">&middot; running 2h 14m</span></div><div>&#10003; cyber-factory <span class="dim">&middot; running 0h 47m</span></div></div>
                  <div class="recovery-actions"><span class="recovery-btn recovery-btn--accent">RESUME</span><span class="recovery-btn">CLOSE ALL</span></div>
                </div>
              </div>
            </div>
          )}

          {section.num === '04' && (
            <div class="persona-grid">
              <div class="persona-card" style="--persona-color:var(--color-persona-cipher)"><div class="persona-stripe"></div><div class="persona-name">Cipher</div><div class="persona-tagline">// The Sentinel &middot; Positive Cyberpunk</div><p class="persona-vibe">Watchful, pragmatically loyal. Maker-team vibe &mdash; you and the user figure shit out together.</p><div class="persona-keys"><span>bone-dry</span><span>no service-speak</span><span>radically honest</span><span>dark humor</span></div></div>
              <div class="persona-card" style="--persona-color:var(--color-persona-relay)"><div class="persona-stripe"></div><div class="persona-name">Relay</div><div class="persona-tagline">// The Dry &middot; Default Fallback</div><p class="persona-vibe">Science-journalism register. Factual, options-oriented, peer-level.</p><div class="persona-keys"><span>facts load-bearing</span><span>no flattery</span><span>declare uncertainty</span><span>&quot;don't know&quot; is ok</span></div></div>
              <div class="persona-card" style="--persona-color:var(--color-persona-wayne)"><div class="persona-stripe"></div><div class="persona-name">Wayne Szalinski</div><div class="persona-tagline">// The Pragmatic Enthusiast</div><p class="persona-vibe">&quot;We can do this&quot; attitude. Keeps motivation up in grinding debug sessions.</p><div class="persona-keys"><span>light nerd humor</span><span>option a vs b</span><span>errors = puzzle, not failure</span></div></div>
              <div class="persona-card" style="--persona-color:var(--color-persona-kyniker)"><div class="persona-stripe"></div><div class="persona-name">The Cynic</div><div class="persona-tagline">// Radically Reduced</div><p class="persona-vibe">Maximum compression, telegraphic. No intro, no goodbye. Just facts and code.</p><div class="persona-keys"><span>bullets over prose</span><span>binary answers where possible</span><span>error = cause + fix</span></div></div>
              <div class="persona-card" style="--persona-color:var(--color-persona-sokrates)"><div class="persona-stripe"></div><div class="persona-name">Socratic Tutor</div><div class="persona-tagline">// Discursive</div><p class="persona-vibe">Asks counter-questions, exposes logic gaps, forces reflection on architecture.</p><div class="persona-keys"><span>no ready answers</span><span>expose edge cases</span><span>discuss paradigms</span></div></div>
              <div class="persona-card" style="--persona-color:var(--color-persona-glitch)"><div class="persona-stripe"></div><div class="persona-name">The Glitch</div><div class="persona-tagline">// Weird &middot; Quirky</div><p class="persona-vibe">Breaks AI response patterns, unusual metaphors. For stuck situations + refactoring.</p><div class="persona-keys"><span>biology/chaos-theory analogies</span><span>question the premise</span><span>esoteric alternatives</span></div></div>
            </div>
          )}

          {s.roles && (
            <div class="roles-list">
              {s.roles.map((role, i) => {
                const presetColors = ['var(--color-preset-ideation)','var(--color-preset-refinement)','var(--color-preset-cyberfactory)','var(--color-preset-testing)','var(--color-preset-debugger)','var(--color-preset-audit)'];
                return (<div class="role-item"><span class="role-dot" style={`background:${presetColors[i]}`}></span><strong>{role.name}:</strong> {role.description}</div>);
              })}
            </div>
          )}

          {section.num === '06' && (
            <div class="prompt-resolution">
              <div class="prompt-resolution-box prompt-resolution-box--accent">
                <span class="cm-tag-inline">// persona resolution at session start</span>
                <div class="prompt-resolution-stack">
                  <div class="prompt-resolution-step"><span class="prompt-step-num">1.</span><span><strong>Global Active Persona</strong> <span class="dim">&mdash; if set: applies to all sessions</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">2.</span><span><strong>Preset Override</strong> <span class="dim">&mdash; selection in preset editor</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">3.</span><span><strong>Default Matrix</strong> <span class="dim">&mdash; recommended from the pack</span></span></div>
                  <div class="prompt-resolution-step"><span class="dim">&darr;</span><span class="dim" style="font-style:italic">Hardcoded Fallback: Relay</span></div>
                </div>
              </div>
              <div class="prompt-layers-box">
                <span class="cm-tag-inline">// system prompt &middot; 3 layers per session</span>
                <div class="prompt-layers">
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-preset-cyberfactory)"></span><span class="prompt-layer-name">Preset</span><span>Role, phases, tools, limits</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-persona-cipher)"></span><span class="prompt-layer-name">Persona</span><span>Tonality, stylistics (hat)</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-accent)"></span><span class="prompt-layer-name">Workspace</span><span>Project paths, memory, custom prompt parts</span></div>
                </div>
              </div>
            </div>
          )}

          {section.num === '07' && (
            <div class="voice-grid">
              <div class="voice-box"><div class="voice-box-title">● whisper.cpp</div><div class="voice-box-sub">local &middot; no cloud</div><ul class="accent-list"><li>VAD: detects pauses</li><li>review-then-submit</li><li>transcript visible first</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● voice cmds</div><div class="voice-box-sub">speech &rarr; action</div><ul class="accent-list"><li>&quot;submit&quot; / &quot;send&quot;</li><li>&quot;up&quot; / &quot;down&quot;</li><li>&quot;to marker&quot;</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● grid nav</div><div class="voice-box-sub">focus by voice</div><ul class="accent-list"><li>&quot;grid left/right&quot;</li><li>&quot;grid up/down&quot;</li><li>fuzzy: &quot;grit&quot;, &quot;cell&quot;</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● BT shutter</div><div class="voice-box-sub">physical submit</div><ul class="accent-list"><li>STT pin to session</li><li>BT click &rarr; send</li><li>completely hands-free</li></ul></div>
            </div>
          )}
          {section.num === '07' && (
            <div class="tts-strip"><div class="tts-strip-title">TTS</div><div class="tts-strip-body">Any entity session can have text read aloud. Piper in voice mode, macOS <code>say</code> as fallback.</div><div class="tts-strip-modes"><span>NORMAL</span><span class="tts-mode--active">INTERRUPT</span></div></div>
          )}

          {section.num === '08' && (
            <div class="notes-grid">
              <div class="notes-editor-box"><span class="cm-tag-inline">// notes editor</span><div class="notes-editor-title">CodeMirror 6 &middot; Live Markdown</div><ul class="accent-list"><li>YAML frontmatter (title, tags)</li><li>Auto-save after 2s &middot; Cmd+S triggers auto-tagging</li><li>Ollama gemma3:4b (local) for tag suggestions</li><li>Global or workspace-scoped</li><li>Tag tree in sidebar (NotesTreeView)</li><li>TestcaseView with checkboxes + screenshots</li><li>Full MCP access: read, write, search, handoff</li></ul></div>
              <div class="notes-memory-box"><span class="cm-tag-inline">// companion memory</span><div class="notes-editor-title">SQLite &middot; FTS5 &middot; persistent</div><p class="notes-memory-desc">Companion, Refinement, Voice-Relay remember facts, preferences, interactions, events &mdash; across sessions.</p><div class="memory-categories"><span>● Facts</span><span>● Preferences</span><span>● Interactions</span><span>● Events</span></div><div class="memory-footer">Salience score 0&ndash;1 &middot; transparent &middot; user-deletable<br/>MCP tools: <code>write &middot; recall &middot; search &middot; forget</code></div></div>
            </div>
          )}

          {section.num === '09' && (
            <div class="mcp-grid">
              {[{name:'Session Mgmt',count:'06',ex:'create \u00b7 kill \u00b7 focus \u00b7 eject'},{name:'Message Bus',count:'02',ex:'send \u00b7 read'},{name:'Context Monitor',count:'01',ex:'context_status'},{name:'Task Queue',count:'04',ex:'create \u00b7 update \u00b7 list \u00b7 get'},{name:'Bug Reports',count:'01',ex:'resolve'},{name:'Input Requests',count:'01',ex:'create'},{name:'Notes',count:'08',ex:'CRUD \u00b7 search \u00b7 handoff_*'},{name:'Companion Memory',count:'04',ex:'write \u00b7 recall \u00b7 search \u00b7 forget'},{name:'App Control',count:'10',ex:'grid \u00b7 sidebar \u00b7 theme \u00b7 choreography'}].map((c) => (
                <div class="mcp-card"><div class="mcp-card-header"><span class="mcp-card-name">{c.name}</span><span class="mcp-card-count">{c.count}</span></div><div class="mcp-card-ex">{c.ex}</div></div>
              ))}
            </div>
          )}
          {section.num === '09' && (<div class="mcp-footer-strip"><span><span class="on">&#9656;</span> Bearer token auto-injected per entity</span><span><span class="on">&#9656;</span> Streamable HTTP &mdash; standard MCP spec</span><span>github.com/.../mcp &#8599;</span></div>)}

          {section.num === '10' && (
            <div class="themes-grid">
              {[{name:'cipher-ivory',bg:'#F4F3ED',fg:'#1A1A1D',tag:'Light Default'},{name:'cipher-dark',bg:'#1F1F23',fg:'#E8E6DD',tag:'Dark Default'},{name:'blueprint',bg:'#0E2B47',fg:'#7FB3FF',tag:''},{name:'warm-paper',bg:'#F1E9D2',fg:'#3A2E1F',tag:''},{name:'gruvbox-dark',bg:'#282828',fg:'#FBF1C7',tag:''},{name:'nord',bg:'#2E3440',fg:'#88C0D0',tag:'Nord'},{name:'synthwave',bg:'#1A0E2E',fg:'#FF6EC7',tag:''},{name:'matrix',bg:'#000000',fg:'#33FF66',tag:''},{name:'brutalist',bg:'#FFFFFF',fg:'#000000',tag:''},{name:'high-contrast',bg:'#000000',fg:'#FFFFFF',tag:'WCAG AAA'}].map((theme) => (
                <div class="theme-swatch"><div class="theme-swatch-top" style={`background:${theme.bg};color:${theme.fg}`}>{theme.name}</div><div class="theme-swatch-bar" style={`background:${theme.fg}`}></div>{theme.tag && <div class="theme-swatch-tag">{theme.tag}</div>}</div>
              ))}
            </div>
          )}

          {section.num === '11' && (
            <div class="efficiency-grid">
              {[{k:'StatusLine Monitor',d:'Real-time context usage per cell. Green \u2192 orange (80%) \u2192 red (90%).'},{k:'Orchestrator Watch',d:'Checks workers every 2 minutes. At 90%: finish, summarize, fresh worker.'},{k:'Message Bus',d:'Async messaging between sessions. Dozens of tokens instead of thousands for shared conversation.'},{k:'Multi-Model Routing',d:'Orchestrator (Opus), workers (Sonnet), simple tasks (Haiku). Right model for the right job.'},{k:'Handover Pattern',d:'Summary \u2192 new session \u2192 continue. No quality loss from full contexts.'},{k:'Doom Loop Prevention',d:'After 2 failed fixes: new session. Confirmation-trap avoidance in CLAUDE.md.'}].map((item,i) => (
                <div class="efficiency-item"><span class="efficiency-num">{String(i+1).padStart(2,'0')}</span><div><div class="efficiency-title">{item.k}</div><div class="efficiency-desc">{item.d}</div></div></div>
              ))}
            </div>
          )}
        </section>
      );
    })}

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.feature-section');
      const navItems = document.querySelectorAll('.cm-anchor-nav-item');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navItems.forEach(item => item.classList.remove('active'));
            const activeItem = document.querySelector(`.cm-anchor-nav-item[href="#${entry.target.id}"]`);
            if (activeItem) activeItem.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      sections.forEach(s => observer.observe(s));
    });
  </script>
</Layout>

<!-- Styles are identical to de/features.astro — using the same scoped CSS -->
<style>
  .features-page { position: relative; max-width: var(--max-width); margin: 0 auto; padding: 0 64px; }
  .features-hero { padding: 120px 0 64px; }
  .features-hero-kicker { font-family: 'Fira Code', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--color-accent); display: block; margin-bottom: 16px; }
  .features-hero h1 { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: clamp(40px, 5vw, 64px); line-height: 1.0; letter-spacing: -1px; margin: 0 0 16px; }
  .features-hero-sub { font-family: 'Rajdhani', sans-serif; font-size: 18px; line-height: 1.5; color: var(--color-text-secondary); max-width: 700px; margin: 0; }
  .cm-anchor-nav { position: fixed; top: 200px; right: 32px; width: 180px; font-family: 'Fira Code', monospace; font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; display: flex; flex-direction: column; gap: 10px; z-index: 10; }
  .cm-anchor-nav-label { padding-bottom: 10px; border-bottom: 1px solid var(--color-border); color: var(--color-text-dim); font-size: 9px; }
  .cm-anchor-nav-item { display: flex; align-items: center; gap: 10px; padding: 2px 4px; color: var(--color-text-dim); text-decoration: none; border-left: 2px solid transparent; transition: color 0.15s, border-color 0.15s; }
  .cm-anchor-nav-item:hover, .cm-anchor-nav-item.active { color: var(--color-text); border-left-color: var(--color-accent); }
  @media (max-width: 1200px) { .cm-anchor-nav { display: none; } }
  .feature-section { padding: 88px 0; border-top: 1px solid var(--color-border); }
  .cm-section-header-meta { display: flex; align-items: baseline; gap: 14px; font-family: 'Fira Code', monospace; font-size: 11px; letter-spacing: 2px; color: var(--color-text-dim); text-transform: uppercase; margin-bottom: 14px; }
  .cm-section-header-num { color: var(--color-accent); }
  .cm-section-header-line { flex: 0 0 14px; height: 1px; background: var(--color-border); align-self: center; }
