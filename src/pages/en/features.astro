---
import Layout from '../../layouts/Layout.astro';
import content from '../../i18n/en/features';
import { t } from '../../i18n/ui';

const lang = 'en';

const sectionIdMap: Record<string, string> = {
  '01': 'cockpit',
  '02': 'grid',
  '03': 'sessions',
  '04': 'presets',
  '05': 'personas',
  '06': 'prompts',
  '07': 'voice',
  '08': 'notes',
  '09': 'mcp',
  '10': 'themes',
  '11': 'efficiency',
};

type SectionWithStats = typeof content.sections[0] & { stats?: readonly { value: string; label: string }[] };
type SectionWithPresets = typeof content.sections[0] & { presets?: readonly { name: string; id: string; color: string; description: string }[] };
type SectionWithPersonas = typeof content.sections[0] & { personas?: readonly { name: string; tagline: string; color: string; vibe: string; keys: readonly string[] }[] };
type SectionWithA11y = typeof content.sections[0] & { a11yProfiles?: readonly { name: string; type: string; affected: string; strategy: string; colors: readonly string[]; screenshot: string }[] };
---

<Layout
  title="Features — CIPHER-MUX"
  description={content.hero.subtext}
  lang={lang}
  active="features"
>
  <div class="features-page">

    <nav class="cm-anchor-nav">
      <div class="cm-anchor-nav-label">{t(lang, 'scroll.label')}</div>
      {content.scrollNavItems.map((item) => (
        <a href={`#${item.id}`} class="cm-anchor-nav-item">
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <section class="features-hero">
      <span class="features-hero-kicker">{content.hero.kicker}</span>
      <h1>{content.hero.title}</h1>
      <p class="features-hero-sub">{content.hero.subtext}</p>
    </section>

    {content.sections.map((section) => {
      const sectionId = sectionIdMap[section.num] ?? section.num;
      const s = section as SectionWithStats & SectionWithPresets & SectionWithPersonas & SectionWithA11y;
      return (
        <section id={sectionId} class="feature-section">
          <header class="cm-section-header">
            <div class="cm-section-header-meta">
              <span class="cm-section-header-num">{section.num}</span>
              <span class="cm-section-header-line"></span>
              <span class="cm-section-header-kicker">{section.kicker}</span>
            </div>
            <h2>{section.title}</h2>
            <p class="cm-section-header-lead">{section.lead}</p>
          </header>

          {/* 01 Cockpit — Real app screenshot with theme switching */}
          {section.num === '01' && (
            <div class="grid-schematic">
              <div class="app-screenshot-wrap">
                <img class="app-screenshot" src="/images/screenshots/cipher-ivory-2x2.webp" alt="CIPHER-MUX — 2×2 grid with Companion, Cyber Factory, Debugger and Refinement in cipher-ivory theme" loading="eager" />
              </div>
              <div class="grid-statusbar"><span class="grid-statusbar-theme">cipher-ivory</span><span class="grid-statusbar-version">v0.9.9</span></div>
              <div class="grid-theme-bar">
                {[
                  { id: 'cipher-ivory',    bg: '#F2F2E8', elevated: '#FFFFF0', sunken: '#E8E8DE', border: '#3A3F47', text: '#1A1A1D', dim: '#6A6A72', accent: '#2d8a4e' },
                  { id: 'cipher-dark',     bg: '#2A2A32', elevated: '#33333C', sunken: '#222228', border: '#3E3E4A', text: '#D8D8E0', dim: '#6E6E80', accent: '#5C9A6E' },
                  { id: 'blueprint',       bg: '#0E2A44', elevated: '#143657', sunken: '#081C30', border: '#2E6FA0', text: '#DCEEFF', dim: '#6A8FB4', accent: '#7FD3FF' },
                  { id: 'warm-paper',      bg: '#F7F2E8', elevated: '#FFFBF0', sunken: '#EDE6D4', border: '#C4B89A', text: '#3A2E1A', dim: '#8A7A5E', accent: '#8B4513' },
                  { id: 'gruvbox-dark',    bg: '#282828', elevated: '#32302F', sunken: '#1D2021', border: '#504945', text: '#EBDBB2', dim: '#928374', accent: '#FABD2F' },
                  { id: 'nord',            bg: '#2E3440', elevated: '#3B4252', sunken: '#242933', border: '#434C5E', text: '#ECEFF4', dim: '#7B8394', accent: '#88C0D0' },
                  { id: 'synthwave',       bg: '#1A0B2E', elevated: '#241040', sunken: '#0E0520', border: '#4A1E6E', text: '#F8E6FF', dim: '#8A6BB0', accent: '#FF2EAA' },
                  { id: 'matrix',          bg: '#000000', elevated: '#030805', sunken: '#000000', border: '#0A5030', text: '#00FF41', dim: '#008820', accent: '#00FF41' },
                  { id: 'brutalist',       bg: '#FFFFFF', elevated: '#FFFFFF', sunken: '#F0F0F0', border: '#000000', text: '#000000', dim: '#707070', accent: '#FF3300' },
                  { id: 'high-contrast',   bg: '#000000', elevated: '#0A0A0A', sunken: '#000000', border: '#FFFFFF', text: '#FFFFFF', dim: '#B0B0B0', accent: '#FFFF00' },
                  { id: 'cvd-deuteranopia', bg: '#1C1C24', elevated: '#26262F', sunken: '#141418', border: '#3C3C4A', text: '#E8E8F0', dim: '#9696A8', accent: '#56B4E9' },
                  { id: 'cvd-tritanopia',   bg: '#1C1C24', elevated: '#26262F', sunken: '#141418', border: '#3C3C4A', text: '#E8E8F0', dim: '#9696A8', accent: '#E06090' },
                  { id: 'cvd-achromatopsia',bg: '#1A1A1A', elevated: '#252525', sunken: '#111111', border: '#404040', text: '#E8E8E8', dim: '#949494', accent: '#E0E0E0' },
                ].map((t) => (
                  <button class="grid-theme-dot" data-theme-id={t.id} data-t-bg={t.bg} data-t-elevated={t.elevated} data-t-sunken={t.sunken} data-t-border={t.border} data-t-text={t.text} data-t-dim={t.dim} data-t-accent={t.accent} style={`background:${t.bg};border-color:${t.border}`} title={t.id} aria-label={`Apply ${t.id} theme`}><span style={`background:${t.accent}`}></span></button>
                ))}
              </div>
            </div>
          )}

          {s.stats && (
            <div class="stat-grid">
              {s.stats.map((stat) => (
                <div class="stat-box">
                  <span class="stat-value">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}

          {section.num === '02' && (
            <div class="layout-gallery">
              <span class="cm-tag-inline">// typical grid configurations</span>
              <div class="layout-screenshot-row">
                <div class="layout-screenshot-item"><div class="layout-screenshot-label"><span>Solo Focus</span><span>1×1</span></div><img src="/images/screenshots/layout-1x1_companion.webp" alt="1×1 grid — solo Companion session" loading="lazy" /></div>
                <div class="layout-screenshot-item"><div class="layout-screenshot-label"><span>Dual</span><span>1×2</span></div><img src="/images/screenshots/layout-1x2_companion_debugger.webp" alt="1×2 grid — Companion and Debugger" loading="lazy" /></div>
                <div class="layout-screenshot-item"><div class="layout-screenshot-label"><span>Triage</span><span>3×2</span></div><img src="/images/screenshots/layout-3x2_six_sessions.webp" alt="3×2 grid — 6 sessions" loading="lazy" /></div>
                <div class="layout-screenshot-item"><div class="layout-screenshot-label"><span>Maker</span><span>4×2</span></div><img src="/images/screenshots/layout-4x2_all8_sessions.webp" alt="4×2 grid — 8 sessions" loading="lazy" /></div>
              </div>
            </div>
          )}

          {section.num === '03' && (
            <div class="sessions-grid">
              <div class="sessions-anatomy">
                <span class="cm-tag-inline">// session anatomy</span>
                <ul class="accent-list"><li>Dedicated Claude Code process per cell</li><li>Own context, own CLAUDE.md, own history</li><li>Header controls: Expand, switch project, Shell, Close</li><li>Click header = focus, visual highlight</li><li><strong>$-Button:</strong> direct access to the session's tmux terminal</li><li><strong>Eject:</strong> detach session from the grid into its own window</li></ul>
              </div>
              <div class="sessions-recovery">
                <span class="cm-tag-inline">// recovery</span>
                <div class="recovery-mock">
                  <div class="recovery-label">// after app restart</div>
                  <div class="recovery-line">● 3 sessions found in tmux</div>
                  <div class="recovery-sessions"><div>&#10003; workshop <span class="dim">&middot; running 2h 14m</span></div><div>&#10003; companion <span class="dim">&middot; running 2h 14m</span></div><div>&#10003; cyber-factory <span class="dim">&middot; running 0h 47m</span></div></div>
                  <div class="recovery-actions"><span class="recovery-btn recovery-btn--accent">RESUME</span><span class="recovery-btn">CLOSE ALL</span></div>
                </div>
              </div>
            </div>
          )}

          {/* 04 Presets — 8 cards */}
          {s.presets && (
            <div class="preset-grid">
              {s.presets.map((preset) => (
                <div class="preset-card" style={`--preset-color:${preset.color}`}>
                  <div class="preset-stripe"></div>
                  <div class="preset-header">
                    <span class="preset-dot" style={`background:${preset.color}`}></span>
                    <span class="preset-name">{preset.name}</span>
                  </div>
                  <div class="preset-id">&gt; {preset.id}</div>
                  <p class="preset-desc">{preset.description}</p>
                </div>
              ))}
            </div>
          )}

          {/* 05 Personas — compact cards with expand */}
          {s.personas && (
            <div class="persona-grid">
              {s.personas.map((persona) => (
                <details class="persona-card" style={`--persona-color:${persona.color}`}>
                  <summary class="persona-summary">
                    <div class="persona-stripe"></div>
                    <div class="persona-name">{persona.name}</div>
                    <div class="persona-tagline">// {persona.tagline}</div>
                    <div class="persona-vibe-short">{persona.vibe}</div>
                  </summary>
                  <div class="persona-detail">
                    <div class="persona-keys">
                      {persona.keys.map((k) => <span>{k}</span>)}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          )}

          {section.num === '06' && (
            <div class="prompt-resolution">
              <div class="prompt-resolution-box prompt-resolution-box--accent">
                <span class="cm-tag-inline">// persona resolution at session start</span>
                <div class="prompt-resolution-stack">
                  <div class="prompt-resolution-step"><span class="prompt-step-num">1.</span><span><strong>Global Active Persona</strong> <span class="dim">&mdash; if set: applies to all sessions</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">2.</span><span><strong>Preset Override</strong> <span class="dim">&mdash; selection in preset editor</span></span></div>
                  <div class="prompt-resolution-step"><span class="prompt-step-num">3.</span><span><strong>Default Matrix</strong> <span class="dim">&mdash; recommended from the pack</span></span></div>
                  <div class="prompt-resolution-step"><span class="dim">&darr;</span><span class="dim" style="font-style:italic">Hardcoded Fallback: Relay</span></div>
                </div>
              </div>
              <div class="prompt-layers-box">
                <span class="cm-tag-inline">// system prompt &middot; 3 layers per session</span>
                <div class="prompt-layers">
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-preset-cyberfactory)"></span><span class="prompt-layer-name">Preset</span><span>Role, phases, tools, limits</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-persona-cipher)"></span><span class="prompt-layer-name">Persona</span><span>Tonality, stylistics (hat)</span></div>
                  <div class="prompt-layer"><span class="prompt-layer-bar" style="background:var(--color-accent)"></span><span class="prompt-layer-name">Workspace</span><span>Project paths, memory, custom prompt parts</span></div>
                </div>
              </div>
            </div>
          )}

          {section.num === '07' && (
            <div class="voice-grid">
              <div class="voice-box"><div class="voice-box-title">● whisper.cpp</div><div class="voice-box-sub">local &middot; no cloud</div><ul class="accent-list"><li>VAD: detects pauses</li><li>review-then-submit</li><li>transcript visible first</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● voice cmds</div><div class="voice-box-sub">speech &rarr; action</div><ul class="accent-list"><li>&quot;submit&quot; / &quot;send&quot;</li><li>&quot;up&quot; / &quot;down&quot;</li><li>&quot;to marker&quot;</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● grid nav</div><div class="voice-box-sub">focus by voice</div><ul class="accent-list"><li>&quot;grid left/right&quot;</li><li>&quot;grid up/down&quot;</li><li>fuzzy: &quot;grit&quot;, &quot;cell&quot;</li></ul></div>
              <div class="voice-box"><div class="voice-box-title">● BT shutter</div><div class="voice-box-sub">physical submit</div><ul class="accent-list"><li>STT pin to session</li><li>BT click &rarr; send</li><li>completely hands-free</li></ul></div>
            </div>
          )}
          {section.num === '07' && (
            <div class="tts-strip"><div class="tts-strip-title">TTS</div><div class="tts-strip-body">Any entity session can have text read aloud. Piper in voice mode, macOS <code>say</code> as fallback.</div><div class="tts-strip-modes"><span>NORMAL</span><span class="tts-mode--active">INTERRUPT</span></div></div>
          )}

          {section.num === '08' && (
            <div class="notes-grid">
              <div class="notes-editor-box"><span class="cm-tag-inline">// notes editor</span><div class="notes-editor-title">CodeMirror 6 &middot; Live Markdown</div><ul class="accent-list"><li>YAML frontmatter (title, tags)</li><li>Auto-save after 2s &middot; Cmd+S triggers auto-tagging</li><li>Ollama gemma3:4b (local) for tag suggestions</li><li>Global or workspace-scoped</li><li>Tag tree in sidebar (NotesTreeView)</li><li>TestcaseView with checkboxes + screenshots</li><li>Full MCP access: read, write, search, handoff</li></ul></div>
              <div class="notes-memory-box"><span class="cm-tag-inline">// companion memory</span><div class="notes-editor-title">SQLite &middot; FTS5 &middot; persistent</div><p class="notes-memory-desc">Companion, Refinement, Voice remember facts, preferences, interactions, events &mdash; across sessions.</p><div class="memory-categories"><span>● Facts</span><span>● Preferences</span><span>● Interactions</span><span>● Events</span></div><div class="memory-footer">Salience score 0&ndash;1 &middot; transparent &middot; user-deletable<br/>MCP tools: <code>write &middot; recall &middot; search &middot; forget</code></div></div>
            </div>
          )}

          {section.num === '09' && (
            <div class="mcp-grid">
              {[{name:'Session Mgmt',count:'06',ex:'create \u00b7 kill \u00b7 focus \u00b7 eject'},{name:'Message Bus',count:'02',ex:'send \u00b7 read'},{name:'Context Monitor',count:'01',ex:'context_status'},{name:'Task Queue',count:'04',ex:'create \u00b7 update \u00b7 list \u00b7 get'},{name:'Bug Reports',count:'01',ex:'resolve'},{name:'Input Requests',count:'01',ex:'create'},{name:'Notes',count:'08',ex:'CRUD \u00b7 search \u00b7 handoff_*'},{name:'Companion Memory',count:'04',ex:'write \u00b7 recall \u00b7 search \u00b7 forget'},{name:'App Control',count:'10',ex:'grid \u00b7 sidebar \u00b7 theme \u00b7 choreography'}].map((c) => (
                <div class="mcp-card"><div class="mcp-card-header"><span class="mcp-card-name">{c.name}</span><span class="mcp-card-count">{c.count}</span></div><div class="mcp-card-ex">{c.ex}</div></div>
              ))}
            </div>
          )}
          {section.num === '09' && (<div class="mcp-footer-strip"><span><span class="on">&#9656;</span> Bearer token auto-injected per entity</span><span><span class="on">&#9656;</span> Streamable HTTP &mdash; standard MCP spec</span><span>github.com/.../mcp &#8599;</span></div>)}

          {/* 10 Accessibility — CVD profile cards */}
          {s.a11yProfiles && (
            <div class="a11y-grid">
              {s.a11yProfiles.map((profile) => (
                <div class="a11y-card">
                  <img class="a11y-card-screenshot" src={profile.screenshot} alt={`CIPHER-MUX in ${profile.name} profile`} loading="lazy" />
                  <div class="a11y-card-body">
                    <div class="a11y-card-colors">
                      {profile.colors.map((c) => (
                        <span class="a11y-color-dot" style={`background:${c}`}></span>
                      ))}
                    </div>
                    <div class="a11y-card-name">{profile.name}</div>
                    <div class="a11y-card-type">{profile.type} &middot; {profile.affected}</div>
                    <div class="a11y-card-strategy">{profile.strategy}</div>
                  </div>
                </div>
              ))}
            </div>
          )}

          {section.num === '11' && (
            <div class="efficiency-grid">
              {[{k:'StatusLine Monitor',d:'Real-time context usage per cell. Green \u2192 orange (80%) \u2192 red (90%).'},{k:'Orchestrator Watch',d:'Checks workers every 2 minutes. At 90%: finish, summarize, fresh worker.'},{k:'Message Bus',d:'Async messaging between sessions. Dozens of tokens instead of thousands for shared conversation.'},{k:'Multi-Model Routing',d:'Workshop (Opus), workers (Sonnet), simple tasks (Haiku). Right model for the right job.'},{k:'Handover Pattern',d:'Summary \u2192 new session \u2192 continue. No quality loss from full contexts.'},{k:'Doom Loop Prevention',d:'After 2 failed fixes: new session. Confirmation-trap avoidance in CLAUDE.md.'}].map((item,i) => (
                <div class="efficiency-item"><span class="efficiency-num">{String(i+1).padStart(2,'0')}</span><div><div class="efficiency-title">{item.k}</div><div class="efficiency-desc">{item.d}</div></div></div>
              ))}
            </div>
          )}
        </section>
      );
    })}

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = document.querySelectorAll('.feature-section');
      const navItems = document.querySelectorAll('.cm-anchor-nav-item');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navItems.forEach(item => item.classList.remove('active'));
            const activeItem = document.querySelector(`.cm-anchor-nav-item[href="#${entry.target.id}"]`);
            if (activeItem) activeItem.classList.add('active');
          }
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      sections.forEach(s => observer.observe(s));

      const screenshot = document.querySelector('.app-screenshot') as HTMLImageElement | null;
      const themeLabel = document.querySelector('.grid-statusbar-theme') as HTMLElement | null;
      document.querySelectorAll('.grid-theme-dot').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!screenshot) return;
          const themeId = (btn as HTMLElement).dataset.themeId!;
          screenshot.src = `/images/screenshots/${themeId}-2x2.webp`;
          screenshot.alt = `CIPHER-MUX in ${themeId} theme`;
          if (themeLabel) themeLabel.textContent = themeId;
          document.querySelectorAll('.grid-theme-dot').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });
  </script>
</Layout>

<style>
  .features-page { position: relative; max-width: var(--max-width); margin: 0 auto; padding: 0 64px; }
  .features-hero { padding: 120px 0 64px; }
  .features-hero-kicker { font-family: 'Fira Code', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--color-accent); display: block; margin-bottom: 16px; }
  .features-hero h1 { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: clamp(40px, 5vw, 64px); line-height: 1.0; letter-spacing: -1px; margin: 0 0 16px; }
  .features-hero-sub { font-family: 'Rajdhani', sans-serif; font-size: 18px; line-height: 1.5; color: var(--color-text-secondary); max-width: 700px; margin: 0; }
  .cm-anchor-nav { position: fixed; top: 200px; right: 32px; width: 180px; font-family: 'Fira Code', monospace; font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; display: flex; flex-direction: column; gap: 10px; z-index: 10; }
  .cm-anchor-nav-label { padding-bottom: 10px; border-bottom: 1px solid var(--color-border); color: var(--color-text-dim); font-size: 9px; }
  .cm-anchor-nav-item { display: flex; align-items: center; gap: 10px; padding: 2px 4px; color: var(--color-text-dim); text-decoration: none; border-left: 2px solid transparent; transition: color 0.15s, border-color 0.15s; }
  .cm-anchor-nav-item:hover, .cm-anchor-nav-item.active { color: var(--color-text); border-left-color: var(--color-accent); }
  @media (max-width: 1200px) { .cm-anchor-nav { display: none; } }
  .feature-section { padding: 88px 0; border-top: 1px solid var(--color-border); }
  .cm-section-header { display: block; margin-bottom: 32px; }
  .cm-section-header-meta { display: flex; align-items: baseline; gap: 14px; font-family: 'Fira Code', monospace; font-size: 11px; letter-spacing: 2px; color: var(--color-text-dim); text-transform: uppercase; margin-bottom: 8px; }
  .cm-section-header-num { color: var(--color-accent); }
  .cm-section-header-line { flex: 0 0 14px; height: 1px; background: var(--color-border); align-self: center; }
  .cm-section-header h2 { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: clamp(24px, 3vw, 32px); line-height: 1.15; letter-spacing: -0.5px; margin: 4px 0 0; }
  .cm-section-header-lead { margin-top: 14px; max-width: 720px; font-family: 'Rajdhani', sans-serif; font-size: 18px; line-height: 1.5; color: var(--color-text-secondary); }
  .cm-tag-inline { display: inline-flex; font-family: 'Fira Code', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--color-accent); padding: 2px 0; }
  .accent-list { list-style: none; padding: 0; margin: 14px 0 0; font-family: 'Fira Code', monospace; font-size: 12.5px; line-height: 1.9; color: var(--color-text-secondary); }
  .accent-list li::before { content: '\25B8'; color: var(--color-accent); margin-right: 8px; }
  .accent-list strong { color: var(--color-text); }
  .on { color: var(--color-accent); }
  .dim { color: var(--color-text-dim); }
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 24px; }
  .stat-box { background: var(--color-bg-elevated); border: 1px solid var(--color-border); clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px); padding: 20px; }
  .stat-value { font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 44px; line-height: 1; color: var(--color-accent); display: block; }
  .stat-label { font-family: 'Fira Code', monospace; font-size: 13px; color: var(--color-text); font-weight: 500; margin-top: 8px; display: block; }
  .grid-schematic { margin-top: 24px; border: 1px solid var(--color-border); clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px); overflow: hidden; }
  .app-screenshot-wrap { background: var(--color-bg-sunken); }
  .app-screenshot { width: 100%; height: auto; display: block; transition: opacity 0.15s ease; }
  .grid-schematic-chrome { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--color-border); background: var(--color-bg-sunken); }
  .grid-schematic-dots { display: flex; gap: 5px; }
