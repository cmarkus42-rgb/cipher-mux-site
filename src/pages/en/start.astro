---
import Layout from '../../layouts/Layout.astro';
import content from '../../i18n/en/install';

const lang = 'en';
---

<Layout
  title="Download & Install — CIPHER-MUX"
  description={content.hero.body}
  lang={lang}
  active="download"
>
  <div class="install-page">

    <!-- Hero -->
    <section class="install-hero">
      <div class="cm-tag">{content.hero.kicker}</div>
      <h1>{content.hero.title}</h1>
      <p class="install-body">{content.hero.body}</p>
    </section>

    <!-- Phase 01 -->
    <section class="install-phase">
      <div class="phase-marker">
        <span class="phase-num">{content.phases[0].num}</span>
      </div>
      <div class="cm-tag">{content.phases[0].kicker}</div>
      <h2>{content.phases[0].title}</h2>
      <p class="install-lead">{content.phases[0].lead}</p>

      <!-- Terminal Mockup -->
      <div class="cm-terminal">
        <div class="cm-terminal-bar">
          <span class="cm-terminal-dot" style="background: #FF5F57"></span>
          <span class="cm-terminal-dot" style="background: #FEBC2E"></span>
          <span class="cm-terminal-dot" style="background: #28C840"></span>
          <span class="cm-terminal-title">Terminal</span>
        </div>
        <div class="cm-terminal-body">
          <code>$ npm install -g @anthropic-ai/claude-code</code>
          <code>$ claude auth</code>
          <code>$ git clone https://github.com/cmarkus42/cipher-mux-electron.git</code>
          <code>$ cd cipher-mux-electron</code>
          <code>$ npm install && npm run build && npm start</code>
        </div>
      </div>
    </section>

    <!-- Phase 02 -->
    <section class="install-phase">
      <div class="phase-marker">
        <span class="phase-num">{content.phases[1].num}</span>
      </div>
      <div class="cm-tag">{content.phases[1].kicker}</div>
      <h2>{content.phases[1].title}</h2>
      <p class="install-lead">{content.phases[1].lead}</p>
    </section>

    <!-- Phase 03 -->
    <section class="install-phase">
      <div class="phase-marker">
        <span class="phase-num">{content.phases[2].num}</span>
      </div>
      <div class="cm-tag">{content.phases[2].kicker}</div>
      <h2>{content.phases[2].title}</h2>
      <p class="install-lead">{content.phases[2].lead}</p>
    </section>

    <!-- Bottom CTA -->
    <div class="install-cta">
      <a href="https://github.com/cmarkus42/cipher-mux-electron" class="cm-btn cm-btn--primary" target="_blank">GitHub Repository</a>
    </div>

  </div>
</Layout>

<style>
  .install-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 64px;
  }

  .install-hero {
    padding: 120px 0 48px;
  }

  .install-hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 4vw, 48px);
    line-height: 1.05;
    margin: 14px 0;
  }

  .install-body,
  .install-lead {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 720px;
  }

  .install-phase {
    padding: 88px 0;
    border-top: 1px solid var(--color-border);
  }

  .install-phase h2 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 32px;
    margin: 14px 0;
  }

  .phase-marker {
    margin-bottom: 16px;
  }

  .phase-num {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 48px;
    color: var(--color-accent);
    opacity: 0.3;
  }

  /* Terminal */
  .cm-terminal {
    margin: 32px 0;
    border: 1px solid var(--color-border);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    overflow: hidden;
  }

  .cm-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--color-terminal-chrome, #0F0F11);
  }

  .cm-terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .cm-terminal-title {
    font-family: 'Fira Code', monospace;
    font-size: 11px;
    color: var(--color-text-dim);
    margin-left: 8px;
  }

  .cm-terminal-body {
    background: var(--color-terminal-bg, #1A1A1D);
    padding: 20px;
    font-family: 'Fira Code', monospace;
    font-size: 13px;
    line-height: 2;
    color: var(--color-terminal-text, #E8E5DC);
    overflow-x: auto;
  }

  .cm-terminal-body code {
    display: block;
  }

  /* CTA */
  .install-cta {
    padding: 48px 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .install-page {
      padding: 0 20px;
    }

    .install-hero {
      padding: 80px 0 40px;
    }

    .install-phase {
      padding: 40px 0;
    }

    .cm-terminal-body {
      font-size: 12px;
    }
  }
</style>
