---
import Layout from '../../layouts/Layout.astro';

const lang = 'en';
---

<Layout
  title="Changelog — CIPHER-MUX"
  description="Release notes and changelog for cipher-mux"
  lang={lang}
  active="changelog"
>
  <div class="changelog-page">

    <section class="changelog-hero">
      <div class="changelog-kicker">Release Notes</div>
      <h1>What's new in<br/><span class="accent">CIPHER-MUX</span></h1>
      <p class="changelog-hero-body">The full changelog lives in the repository. No double content — one source of truth.</p>
    </section>

    <section class="changelog-redirect">
      <div class="changelog-redirect-inner">
        <p>All release notes, feature waves and bugfixes are on GitHub — always up to date, always complete.</p>
        <a href="https://github.com/cmarkus42-rgb/cipher-mux-electron/blob/main/CHANGELOG.md" class="changelog-redirect-btn" target="_blank" rel="noopener noreferrer">CHANGELOG.md on GitHub &nearr;</a>
        <a href="https://github.com/cmarkus42-rgb/cipher-mux-electron/releases" class="changelog-redirect-link" target="_blank" rel="noopener noreferrer">GitHub Releases &nearr;</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .changelog-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 64px;
  }
  .accent { color: var(--color-accent); }

  .changelog-hero {
    padding: 120px 0 48px;
    border-bottom: 1px solid var(--color-border);
  }
  .changelog-kicker {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }
  .changelog-hero h1 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.0;
    letter-spacing: -1px;
    margin: 0 0 16px;
  }
  .changelog-hero-body {
    font-family: 'Rajdhani', sans-serif;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 700px;
  }

  .changelog-redirect { padding: 64px 0; }
  .changelog-redirect-inner { max-width: 600px; }
  .changelog-redirect-inner p { font-family: 'Rajdhani', sans-serif; font-size: 17px; color: var(--color-text-secondary); line-height: 1.5; margin: 0 0 24px; }
  .changelog-redirect-btn { display: inline-block; padding: 14px 22px; background: var(--color-accent); color: var(--color-bg); font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px); margin-right: 16px; }
  .changelog-redirect-btn:hover { opacity: 0.9; text-decoration: none; }
  .changelog-redirect-link { font-family: 'Fira Code', monospace; font-size: 13px; color: var(--color-text-secondary); text-decoration: none; border-bottom: 1px dotted var(--color-text-dim); padding-bottom: 2px; }
  .changelog-redirect-link:hover { color: var(--color-accent); }

  .changelog-release {
    padding: 48px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .release-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .release-version {
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    color: var(--color-accent);
    letter-spacing: 0.5px;
    padding: 4px 12px;
    border: 1px solid var(--color-accent);
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .release-date {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 0.5px;
  }
  .release-tag {
    font-family: 'Fira Code', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 3px 10px;
    clip-path: polygon(4px 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%, 0 4px);
  }
  .release-tag--latest {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .changelog-release h2 {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0 0 10px;
  }
  .release-summary {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 780px;
    margin: 0 0 24px;
  }
  .changelog-category {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 20px 0 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cat-dot {
    width: 10px;
    height: 10px;
    display: inline-block;
    clip-path: polygon(3px 0, 100% 0, 100% calc(100% - 3px), calc(100% - 3px) 100%, 0 100%, 0 3px);
  }
  .cat-dot--added { background: var(--color-accent); }
  .cat-dot--fixed { background: #E69F00; }
  .cat-dot--changed { background: #56B4E9; }
  .changelog-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .changelog-list li {
    font-family: 'Fira Code', monospace;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--color-text-secondary);
    padding: 4px 0;
    border-top: 1px dotted var(--color-border);
  }
  .changelog-list li:first-child { border-top: none; }
  .changelog-list li::before {
    content: '\25B8';
    color: var(--color-accent);
    margin-right: 8px;
  }
  .changelog-list strong {
    color: var(--color-text);
  }
  .changelog-list code {
    font-size: 11px;
    background: var(--color-bg-elevated);
    padding: 1px 5px;
    border: 1px solid var(--color-border);
  }
  .changelog-bottom {
    padding: 48px 0;
  }
  .changelog-bottom p {
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    color: var(--color-text-secondary);
  }
  .changelog-bottom a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .changelog-bottom a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .changelog-page { padding: 0 20px; }
    .changelog-hero { padding: 80px 0 40px; }
    .changelog-release { padding: 32px 0; }
    .release-header { flex-wrap: wrap; }
  }
</style>
