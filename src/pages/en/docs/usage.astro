---
import Layout from '../../../layouts/Layout.astro';
import DocsNav from '../../../components/DocsNav.astro';
import DocsHero from '../../../components/DocsHero.astro';
import DocsSection from '../../../components/DocsSection.astro';
import Callout from '../../../components/Callout.astro';
import content from '../../../i18n/en/docs-usage';

const lang = 'en';
---

<Layout title="Using the App — CIPHER-MUX" description={content.hero.body} lang={lang} active="docs">
  <div class="docs-page">
    <DocsNav lang={lang} activePage="usage" />

    <DocsHero
      kicker={content.hero.kicker}
      title={content.hero.title}
      titleAccent={content.hero.titleAccent}
      body={content.hero.body}
    />

    <DocsSection id="translation" num="--" title="Translation in Progress">
      <Callout kind="tip" title="Translation in Progress">
        <span>{content.translationNote}</span>
        <br /><br />
        <a href={content.germanLink} class="docs-translation-link">{content.germanLabel} &rarr;</a>
      </Callout>
    </DocsSection>
  </div>
</Layout>

<style>
  .docs-page {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
  }

  .docs-translation-link {
    color: var(--color-accent);
    text-decoration: none;
  }
  .docs-translation-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .docs-page { padding: 0 var(--space-lg); }
  }
</style>
